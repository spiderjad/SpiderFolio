NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173          # en producción: https://app.tudominio.com
WEB_URL=http://localhost:4321          # en producción: https://tudominio.com
# Web pública (se fija al compilar la web): enlaces «Empezar gratis» (/register) e «Iniciar sesión» (/login)
JWT_ACCESS_SECRET=                     # mínimo 64 caracteres aleatorios
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
DATABASE_URL=postgresql://spiderfolio:spiderfolio@localhost:5432/spiderfolio
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SpiderFolio <no-reply@tudominio.com>"
STORAGE_DRIVER=s3                       # s3 (RustFS en local, R2, MinIO…) o local (disco, STORAGE_DIR)
STORAGE_DIR=                            # con STORAGE_DRIVER=local: carpeta de los archivos
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_FORCE_PATH_STYLE=true                # true en RustFS local; R2 funciona con ambos
S3_BUCKET=spiderfolio-files
S3_SYSTEM_BUCKET=spiderfolio-files-system     # ZIP generados en segundo plano (7 días, fuera de la cuota); por defecto <S3_BUCKET>-system
S3_ACCESS_KEY=                          # en local: usuario de RustFS (mínimo 3 caracteres)
S3_SECRET_KEY=                          # en local: contraseña de RustFS (mínimo 8 caracteres)
# Gotenberg (HTML → PDF del PDF controlado); en producción, solo red interna.
GOTENBERG_URL=http://127.0.0.1:3000     # vacío: sin PDF de páginas controladas (la app lo avisa)
APP_STATIC_DIR=                         # la app compilada que sirve la API (instalación propia); vacío en desarrollo
TRUST_PROXY_HOPS=1                      # saltos de proxy de confianza (1 detrás de Caddy o Vite; 0 sin proxy)
TERMS_VERSION=2026-10-01          # versión vigente de Términos y Privacidad; al cambiarla se pide aceptar de nuevo
SENTRY_DSN=
# SMTP propio por empresa: clave AES-256-GCM de 32 bytes en base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Obligatoria en producción; este valor es solo de desarrollo.
EMAIL_ENCRYPTION_KEY=c3BpZGVyZm9saW8tZGV2LWVtYWlsLWtleS0zMmJ5dGU=
# Verificación en dos pasos: clave AES-256-GCM propia (distinta de la del SMTP), 32 bytes en base64. Obligatoria en producción.
MFA_ENCRYPTION_KEY=
EMAIL_ALLOW_PRIVATE_HOSTS=true          # solo desarrollo (Mailpit); en producción false o vacío
EMAIL_DOMAIN_PROVIDER=                  # proveedor de dominios verificados; vacío = «próximamente» (memory: solo pruebas)
BIAN_ENABLED=false                      # asistente IA Bian; si es true, exige ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=                      # clave de la API de Anthropic (solo en el servidor y el worker)
SEED_DEMO_PASSWORD=                     # solo local: contraseña de los usuarios demo (mínimo 10)
PLUGINS_DIR=                            # carpeta de plugins; vacío = plugins/ en la raíz (docs/spec/plugins.md)
PLUGIN_PACKAGES=                        # paquetes npm de plugins (privados), separados por comas
