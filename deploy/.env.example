# SpiderFolio en un servidor propio: copiar a .env y completar. Nunca subir .env a un repositorio.
# Generar secretos:  openssl rand -base64 48   (JWT)   ·   openssl rand -base64 32   (claves de 32 bytes)

# ─── Dirección ───────────────────────────────────────────────────────────────
# URL pública de la app (con el perfil https: https://DOMAIN).
APP_URL=http://localhost:8080
# Web informativa a la que enlazan los emails (puede ser la misma APP_URL).
WEB_URL=http://localhost:8080
# Con el perfil https: el dominio (registro A apuntando a este servidor).
DOMAIN=
# Puerto y dirección donde se publica la app sin Caddy (127.0.0.1 = solo este equipo).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Saltos de proxy de confianza para la IP del cliente: 1 detrás de Caddy u otro proxy; 0 sin proxy.
TRUST_PROXY_HOPS=1

# ─── Base de datos ───────────────────────────────────────────────────────────
POSTGRES_USER=spiderfolio
POSTGRES_PASSWORD=
POSTGRES_DB=spiderfolio

# ─── Secretos ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# 32 bytes en base64, distintas entre sí.
EMAIL_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=

# ─── Email (obligatorio: verificación, invitaciones, avisos) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SpiderFolio <no-reply@tu-dominio.com>"

# ─── Archivos ────────────────────────────────────────────────────────────────
# local: en el volumen «files» (copias: docs/instalacion/copias-de-seguridad.md). s3: S3, R2, MinIO…
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=false
S3_BUCKET=
S3_SYSTEM_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── PDF de documentos controlados (perfil pdf) ──────────────────────────────
# Con el perfil pdf: http://gotenberg:3000. Vacío: sin PDF controlado (la app lo avisa).
GOTENBERG_URL=

# ─── Bian, el asistente IA (opcional) ────────────────────────────────────────
# Las consultas se cobran en la cuenta de Anthropic de esta instalación.
BIAN_ENABLED=false
ANTHROPIC_API_KEY=

# ─── Plugins (opcional) ──────────────────────────────────────────────────────
# Paquetes npm de plugins instalados en la imagen, separados por comas.
PLUGIN_PACKAGES=

# ─── Observabilidad (opcional) ───────────────────────────────────────────────
SENTRY_DSN=

# Imagen a usar (por defecto, la última publicada).
SPIDERFOLIO_IMAGE=ghcr.io/spiderjad/spiderfolio:latest
