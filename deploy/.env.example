# SpiderFolio: copiar a .env y completar (o usar setup.ps1 / setup.sh).
# SpiderFolio: copy to .env and fill in (or use setup.ps1 / setup.sh).
# Nunca subir .env a un repositorio. / Never commit .env to a repository.
# Los valores de ejemplo sirven para probar en tu PC.
# The example values work for trying it on your PC.

# ─── Dirección / Address ─────────────────────────────────────────────────────
# URL con la que se entra a la app (con https: https://DOMAIN).
# URL people use to open the app (with https: https://DOMAIN).
APP_URL=http://localhost:8080
# Web pública del proyecto (documentación y legales). Pon la misma APP_URL.
# The project's public website (docs and legal pages). Use the same APP_URL.
WEB_URL=http://localhost:8080
# Solo con el perfil https: el dominio, sin https://.
# Only with the https profile: the domain, without https://.
DOMAIN=
# Dónde escucha la app. 127.0.0.1 = solo este equipo.
# Where the app listens. 127.0.0.1 = this machine only.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Proxies delante de la app: 1 con Caddy u otro proxy, 0 sin proxy.
# Proxies in front of the app: 1 with Caddy or another proxy, 0 without.
TRUST_PROXY_HOPS=1

# ─── Perfiles / Profiles ─────────────────────────────────────────────────────
# Separados por comas / comma-separated: https, pdf, mail.
# https = Caddy con HTTPS / Caddy with HTTPS.
# pdf = Gotenberg (PDF controlado / controlled PDF).
# mail = Mailpit, bandeja de prueba / test inbox (http://localhost:8025).
COMPOSE_PROFILES=mail
# Puerto de la bandeja de Mailpit. / Mailpit inbox port.
MAIL_UI_PORT=8025

# ─── Base de datos / Database ────────────────────────────────────────────────
POSTGRES_USER=spiderfolio
# Contraseña larga (genérala como un secreto).
# A long password (generate it like a secret).
POSTGRES_PASSWORD=
POSTGRES_DB=spiderfolio

# ─── Secretos / Secrets ──────────────────────────────────────────────────────
# Linux: openssl rand -base64 48 · Windows: ver la guía / see the guide.
# 48 bytes en base64 (64 caracteres). / 48 bytes in base64 (64 chars).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# 32 bytes en base64 (openssl rand -base64 32), distinta de la de MFA.
# 32 bytes in base64 (openssl rand -base64 32), different from MFA's.
EMAIL_ENCRYPTION_KEY=
# 32 bytes en base64. Guárdala: sin ella no se entra con 2FA.
# 32 bytes in base64. Keep it safe: without it 2FA sign-in fails.
MFA_ENCRYPTION_KEY=

# ─── Email ───────────────────────────────────────────────────────────────────
# Servidor SMTP. Para probar: mailpit y 1025 (perfil mail).
# SMTP server. For testing: mailpit and 1025 (mail profile).
SMTP_HOST=mailpit
SMTP_PORT=1025
# Usuario y contraseña SMTP (vacíos con Mailpit).
# SMTP user and password (empty with Mailpit).
SMTP_USER=
SMTP_PASS=
# Remitente de los emails. / Sender of the emails.
MAIL_FROM="SpiderFolio <no-reply@example.com>"

# ─── Archivos / Files ────────────────────────────────────────────────────────
# local: volumen «files» / "files" volume. s3: S3, R2, MinIO…
STORAGE_DRIVER=local
# Con s3, quita el # y completa. / With s3, remove the # and fill in.
#S3_ENDPOINT=
#S3_REGION=
#S3_FORCE_PATH_STYLE=false
#S3_BUCKET=
#S3_SYSTEM_BUCKET=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# ─── PDF de documentos controlados / Controlled-document PDF ─────────────────
# Con el perfil pdf: http://gotenberg:3000. Vacío: sin PDF.
# With the pdf profile: http://gotenberg:3000. Empty: no PDF.
GOTENBERG_URL=

# ─── Bian, asistente IA / AI assistant (opcional / optional) ─────────────────
# Las consultas se cobran en tu cuenta de Anthropic.
# Queries are billed to your Anthropic account.
BIAN_ENABLED=false
ANTHROPIC_API_KEY=

# ─── Plugins (opcional / optional) ───────────────────────────────────────────
# Paquetes npm de plugins, separados por comas.
# npm plugin packages, comma-separated.
PLUGIN_PACKAGES=

# ─── Observabilidad / Observability (opcional / optional) ────────────────────
SENTRY_DSN=

# Imagen a usar (por defecto, la última). / Image to use (default: latest).
SPIDERFOLIO_IMAGE=ghcr.io/spiderjad/spiderfolio:latest
