---
// Plugins and services: a catalog with descriptions and a "Contact" button, no prices.
import Icon from "../components/Icon.astro";
import { CONTACT_EMAIL } from "../config/site.ts";
import { pageAlternates, texts, type Locale } from "../i18n/index.ts";
import MarketingLayout from "../layouts/MarketingLayout.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const oss = texts(locale).oss;
const t = oss.plugins;
/** mailto with the item as the subject; without a contact email, there's no button. */
const contact = (title: string): string | null =>
  CONTACT_EMAIL === null
    ? null
    : `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(t.contactSubject(title))}`;
const enterpriseHref = contact(t.enterprise.title);
const h2 = "font-display text-4xl tracking-tight";
const contactLink =
  "mt-6 inline-flex h-10 w-fit items-center gap-2 rounded-full border px-5 text-sm font-medium transition-colors hover:bg-muted";
---

<MarketingLayout
  locale={locale}
  title={t.title}
  description={t.subtitle}
  alternates={pageAlternates("plugins")}
>
  <section class="hero-glow">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-16 sm:px-6 md:pt-20">
      <h1 class="font-display text-5xl tracking-tight md:text-6xl">{t.title}</h1>
      <p class="mt-5 max-w-3xl text-lg text-muted-foreground">{t.subtitle}</p>
      <ul class="mt-8 grid max-w-3xl gap-2 text-sm">
        {
          t.how.map((item) => (
            <li class="flex gap-3">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-primary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="plugins-title" class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <h2 id="plugins-title" class={h2}>{t.pluginsTitle}</h2>
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((plugin) => {
          const href = contact(plugin.title);
          return (
            <article id={plugin.id} class="reveal flex min-w-0 flex-col rounded-2xl border bg-background p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-11 items-center justify-center rounded-lg bg-primary-soft text-primary-soft-foreground">
                  <Icon name={plugin.icon} />
                </span>
                <span
                  class:list={[
                    "rounded-full px-2.5 py-1 text-xs font-medium",
                    plugin.available
                      ? "bg-success-soft text-success-soft-foreground"
                      : "bg-muted text-muted-foreground",
                  ]}
                >
                  {plugin.available ? t.status.available : t.status.soon}
                </span>
              </div>
              <h3 class="mt-5 text-lg font-semibold">{plugin.title}</h3>
              <p class="mt-2 flex-1 text-sm text-muted-foreground">{plugin.text}</p>
              {href !== null && (
                <a href={href} class={contactLink}>
                  {oss.cta.contact}
                  <Icon name="arrow-right" size={16} />
                </a>
              )}
            </article>
          );
        })
      }
    </div>

    <div id="enterprise" class="reveal mt-10 grid gap-6 rounded-2xl border-2 border-primary bg-background p-7 md:grid-cols-[1fr_1fr]">
      <div class="min-w-0">
        <h3 class="text-2xl font-semibold">{t.enterprise.title}</h3>
        <p class="mt-2 text-muted-foreground">{t.enterprise.text}</p>
        {
          enterpriseHref !== null && (
            <a
              href={enterpriseHref}
              class="mt-6 inline-flex h-11 items-center gap-2 rounded-full bg-foreground px-6 text-sm font-medium text-background transition-opacity hover:opacity-90"
            >
              {oss.cta.contact}
              <Icon name="arrow-right" size={16} />
            </a>
          )
        }
      </div>
      <ul class="min-w-0 space-y-3 text-sm">
        {
          t.enterprise.items.map((item) => (
            <li class="flex gap-3">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-primary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id={t.servicesAnchor}
    aria-labelledby="services-title"
    class="border-t bg-surface"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 id="services-title" class={h2}>{t.servicesTitle}</h2>
      <p class="mt-4 max-w-2xl text-muted-foreground">{t.servicesText}</p>
      <ul class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          t.services.map((service) => {
            const href = contact(service.title);
            return (
              <li id={service.id} class="reveal flex min-w-0 flex-col rounded-2xl border bg-background p-6">
                <span class="inline-flex size-11 items-center justify-center rounded-lg bg-primary-soft text-primary-soft-foreground">
                  <Icon name={service.icon} />
                </span>
                <h3 class="mt-5 text-lg font-semibold">{service.title}</h3>
                <p class="mt-2 flex-1 text-sm text-muted-foreground">{service.text}</p>
                {href !== null && (
                  <a href={href} class={contactLink}>
                    {oss.cta.contact}
                    <Icon name="arrow-right" size={16} />
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="border-t">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <h2 class={h2}>{t.contactTitle}</h2>
      <p class="mt-4 text-muted-foreground">{t.contactText}</p>
      {
        CONTACT_EMAIL !== null && (
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="mt-8 inline-flex h-12 items-center rounded-full bg-foreground px-7 font-medium text-background transition-opacity hover:opacity-90"
          >
            {oss.cta.contact}
          </a>
        )
      }
    </div>
  </section>
</MarketingLayout>
