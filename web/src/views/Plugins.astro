---
import Icon from "../components/Icon.astro";
import PriceTag from "../components/PriceTag.astro";
import { isPriceId, PRICES } from "../config/pricing.ts";
import { CONTACT_EMAIL } from "../config/site.ts";
import { pageAlternates, pagePath, texts, type Locale } from "../i18n/index.ts";
import MarketingLayout from "../layouts/MarketingLayout.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const oss = texts(locale).oss;
const t = oss.plugins;
/** mailto con el asunto del plugin; sin email configurado, no hay botón. */
const contact = (title: string): string | null =>
  CONTACT_EMAIL === null
    ? null
    : `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(t.contactSubject(title))}`;
const pricingHref = pagePath("home", locale, locale === "es" ? "precios" : "pricing");
---

<MarketingLayout
  locale={locale}
  title={t.title}
  description={t.subtitle}
  alternates={pageAlternates("plugins")}
>
  <section class="hero-glow">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-16 sm:px-6 md:pt-20">
      <h1 class="font-display text-5xl tracking-tight md:text-6xl">{t.title}</h1>
      <p class="mt-5 max-w-3xl text-lg text-muted-foreground">{t.subtitle}</p>
      <ul class="mt-8 grid max-w-3xl gap-2 text-sm">
        {
          t.how.map((item) => (
            <li class="flex gap-3">
              <Icon name="check" size={18} class="mt-0.5 shrink-0 text-primary" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-3">
      <p class="text-sm text-muted-foreground">{t.pricesNote}</p>
      <a href={pricingHref} class="inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline">
        {t.pricesLink}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((plugin) => {
          const href = contact(plugin.title);
          return (
            <article id={plugin.id} class="reveal flex flex-col rounded-2xl border bg-background p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="inline-flex size-11 items-center justify-center rounded-lg bg-primary-soft text-primary-soft-foreground">
                  <Icon name={plugin.icon} />
                </span>
                <span
                  class:list={[
                    "rounded-full px-2.5 py-1 text-xs font-medium",
                    plugin.available
                      ? "bg-success-soft text-success-soft-foreground"
                      : "bg-muted text-muted-foreground",
                  ]}
                >
                  {plugin.available ? t.status.available : t.status.soon}
                </span>
              </div>
              <h2 class="mt-5 text-lg font-semibold">{plugin.title}</h2>
              <p class="mt-2 flex-1 text-sm text-muted-foreground">{plugin.text}</p>
              {isPriceId(plugin.id) && (
                <div class="mt-5 border-t pt-5">
                  <PriceTag locale={locale} price={PRICES[plugin.id]} />
                </div>
              )}
              {href !== null && (
                <a
                  href={href}
                  class="mt-6 inline-flex h-10 w-fit items-center gap-2 rounded-full border px-5 text-sm font-medium transition-colors hover:bg-muted"
                >
                  {oss.cta.contact}
                  <Icon name="arrow-right" size={16} />
                </a>
              )}
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="border-t bg-surface">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
      <h2 class="font-display text-4xl tracking-tight">{t.contactTitle}</h2>
      <p class="mt-4 text-muted-foreground">{t.contactText}</p>
      {
        CONTACT_EMAIL !== null && (
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="mt-8 inline-flex h-12 items-center rounded-full bg-foreground px-7 font-medium text-background transition-opacity hover:opacity-90"
          >
            {oss.cta.contact}
          </a>
        )
      }
    </div>
  </section>
</MarketingLayout>
