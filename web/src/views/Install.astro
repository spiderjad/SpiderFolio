---
import Icon from "../components/Icon.astro";
import { DOCS_REPO_URL } from "../config/site.ts";
import { pageAlternates, texts, type Locale } from "../i18n/index.ts";
import MarketingLayout from "../layouts/MarketingLayout.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const oss = texts(locale).oss;
const t = oss.install;
---

<MarketingLayout
  locale={locale}
  title={t.title}
  description={t.subtitle}
  alternates={pageAlternates("install")}
>
  <section class="hero-glow">
    <div class="mx-auto max-w-4xl px-4 pb-12 pt-16 sm:px-6 md:pt-20">
      <h1 class="font-display text-5xl tracking-tight md:text-6xl">{t.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted-foreground">{t.subtitle}</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-12 sm:px-6">
    <h2 class="text-xl font-semibold">{t.requirementsTitle}</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        t.requirements.map((item) => (
          <li class="flex gap-3 rounded-xl border bg-surface p-4 text-sm">
            <Icon name="check" size={18} class="mt-0.5 shrink-0 text-primary" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <ol class="grid grid-cols-1 gap-6">
      {
        t.steps.map((step, index) => (
          <li class="reveal min-w-0 rounded-2xl border bg-background p-6">
            <div class="flex items-center gap-3">
              <span class="inline-flex size-9 items-center justify-center rounded-full bg-primary font-semibold text-primary-foreground">
                {index + 1}
              </span>
              <h3 class="text-lg font-semibold">{step.title}</h3>
            </div>
            <p class="mt-3 text-muted-foreground">{step.text}</p>
            <pre class="mt-4 overflow-x-auto rounded-xl bg-muted p-4 font-mono text-sm"><code>{step.code}</code></pre>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="border-y bg-surface">
    <div class="mx-auto grid max-w-4xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-semibold">{t.optionalTitle}</h2>
        <ul class="mt-4 space-y-4">
          {
            t.optional.map((item) => (
              <li>
                <p class="font-medium">{item.title}</p>
                <p class="text-sm text-muted-foreground">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-semibold">{t.maintenanceTitle}</h2>
        <ul class="mt-4 space-y-4">
          {
            t.maintenance.map((item) => (
              <li>
                <p class="font-medium">{item.title}</p>
                <p class="text-sm text-muted-foreground">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6">
    <a
      href={DOCS_REPO_URL}
      class="inline-flex h-12 items-center gap-2 rounded-full bg-foreground px-7 font-medium text-background transition-opacity hover:opacity-90"
    >
      {oss.cta.docs}
      <Icon name="arrow-right" size={18} />
    </a>
  </section>
</MarketingLayout>
