---
import { REPO_URL, SITE } from "../config/site.ts";
import { docPath, pagePath, texts, type Alternates, type Locale } from "../i18n/index.ts";
import Icon from "./Icon.astro";
import LanguagePicker from "./LanguagePicker.astro";

interface Props {
  locale: Locale;
  alternates?: Alternates;
}
const { locale, alternates } = Astro.props;
const t = texts(locale);
const nav = [
  { label: t.nav.features, href: pagePath("home", locale, t.home.featuresAnchor) },
  { label: t.nav.install, href: pagePath("install", locale) },
  { label: t.nav.plugins, href: pagePath("plugins", locale) },
  { label: t.nav.docs, href: docPath("intro", locale) },
  { label: t.nav.faq, href: pagePath("faq", locale) },
];
const installHref = pagePath("install", locale);

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string): boolean => {
  if (href.includes("#")) return false;
  const target = href.replace(/\/$/, "");
  return target !== "" && (path === target || path.startsWith(`${target}/`));
};
---

<header class="site-header sticky top-0 z-40 border-b bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={pagePath("home", locale)} class="inline-flex items-center gap-2 text-lg font-semibold tracking-tight">
      <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
      {SITE.name}
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="rounded-lg px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <LanguagePicker locale={locale} alternates={alternates} />
      <button
        type="button"
        data-theme-toggle
        aria-label={t.theme.toggle}
        class="inline-flex size-10 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      >
        <Icon name="moon" class="dark:hidden" />
        <Icon name="sun" class="hidden dark:block" />
      </button>
      <a
        href={REPO_URL}
        class="hidden h-10 items-center rounded-lg px-3 text-sm text-muted-foreground transition-colors hover:text-foreground lg:inline-flex"
      >
        GitHub
      </a>
      <a
        href={installHref}
        class="hidden h-10 items-center rounded-full bg-foreground px-5 text-sm font-medium text-background transition-opacity hover:opacity-90 sm:inline-flex"
      >
        {t.cta.install}
      </a>
      <details class="group md:hidden">
        <summary
          aria-label={t.theme.menu}
          class="inline-flex size-10 cursor-pointer items-center justify-center rounded-lg text-muted-foreground hover:bg-muted"
        >
          <Icon name="menu" class="group-open:hidden" />
          <Icon name="x" class="hidden group-open:block" />
        </summary>
        <nav
          aria-label={t.a11y.mobileNav}
          class="absolute inset-x-0 top-16 border-b bg-background px-4 pb-4 pt-2 shadow-pop"
        >
          {
            nav.map((item) => (
              <a href={item.href} class="block rounded-lg px-3 py-3 text-base hover:bg-muted">
                {item.label}
              </a>
            ))
          }
          <a href={REPO_URL} class="block rounded-lg px-3 py-3 text-base hover:bg-muted">
            GitHub
          </a>
          <a
            href={installHref}
            class="mt-2 flex h-11 items-center justify-center rounded-full bg-foreground text-sm font-medium text-background"
          >
            {t.cta.install}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const THEME_KEY = "spiderfolio-theme";
  // Lo lee /lang-redirect.js en la portada (/) para volver al idioma elegido.
  const LOCALE_KEY = "spiderfolio-locale";
  // Listeners en document: siguen valiendo cuando View Transitions cambia el DOM.
  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const choice = target?.closest<HTMLElement>("[data-locale-choice]");
    if (choice?.dataset.localeChoice) {
      try {
        window.localStorage.setItem(LOCALE_KEY, choice.dataset.localeChoice);
      } catch {
        // Sin almacenamiento: la portada usa el idioma del navegador.
      }
    }
    // Cierra el selector de idioma al pulsar fuera de él.
    for (const picker of document.querySelectorAll<HTMLDetailsElement>(".language-picker[open]")) {
      if (!target || !picker.contains(target)) picker.open = false;
    }
    const button = target?.closest("[data-theme-toggle]");
    if (!button) return;
    const dark = document.documentElement.classList.toggle("dark");
    try {
      window.localStorage.setItem(THEME_KEY, dark ? "dark" : "light");
    } catch {
      // Sin almacenamiento: el tema vale solo para esta visita.
    }
  });
</script>
