---
// Diagrama: el acceso va a departamentos; la carpeta dice quién entra y por qué. Los enlaces se dibujan
// al entrar en pantalla (data-animate); sin movimiento, se ven completos.
import Icon from "../Icon.astro";

interface Props {
  t: { departments: readonly string[]; space: string; why: string; people: readonly string[] };
}
const { t } = Astro.props;
---

<div class="permissions" data-animate aria-hidden="true">
  <ul class="column">
    {
      t.departments.map((department, index) => (
        <li class:list={["chip", index === 1 && "active"]} style={`--i: ${String(index)}`}>
          <Icon name="users" size={16} />
          {department}
        </li>
      ))
    }
  </ul>
  <svg class="links" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path d="M0 50 C 50 50, 50 50, 100 50" class="main" pathLength="1"></path>
    <path d="M0 18 C 50 18, 50 50, 100 50" class="faint" pathLength="1"></path>
    <path d="M0 82 C 50 82, 50 50, 100 50" class="faint" pathLength="1"></path>
  </svg>
  <div class="folder">
    <Icon name="folder" size={18} />
    <span class="path">{t.space}</span>
    <span class="why">{t.why}</span>
    <span class="people">
      {
        t.people.map((person, index) => (
          <span class="avatar" style={`--i: ${String(index)}`} title={person}>
            {person.charAt(0)}
          </span>
        ))
      }
    </span>
  </div>
</div>

<style>
  .permissions {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr) minmax(0, 1.4fr);
    align-items: center;
  }
  .column {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    padding: 0.35rem 0.75rem;
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }
  .chip.active {
    border-color: hsl(var(--primary));
    background: hsl(var(--primary-soft));
    color: hsl(var(--primary-soft-foreground));
    font-weight: 500;
  }
  .links {
    width: 100%;
    height: 7.5rem;
    overflow: visible;
  }
  .links path {
    fill: none;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
  }
  .links .main {
    stroke: hsl(var(--primary));
  }
  .links .faint {
    stroke: hsl(var(--border));
    stroke-dasharray: 0.04 0.03;
  }
  .folder {
    display: grid;
    gap: 0.35rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    padding: 0.85rem 1rem;
    box-shadow: 0 10px 30px -18px hsl(var(--foreground) / 0.35);
  }
  .folder :global(svg) {
    color: hsl(var(--primary));
  }
  .path {
    font-weight: 600;
    font-size: 0.875rem;
    word-break: break-word;
  }
  .why {
    font-size: 0.8125rem;
    color: hsl(var(--muted-foreground));
  }
  .people {
    display: flex;
    margin-top: 0.25rem;
  }
  .avatar {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-left: -0.35rem;
    border-radius: 999px;
    border: 2px solid hsl(var(--background));
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    font-size: 0.75rem;
    font-weight: 600;
  }
  .avatar:first-child {
    margin-left: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .permissions.is-in .main {
      animation: draw 1.1s var(--motion-ease-out, ease-out) both 0.3s;
    }
    .permissions.is-in .chip {
      animation: slide 0.5s ease-out both;
      animation-delay: calc(var(--i) * 0.12s);
    }
    .permissions.is-in .avatar {
      animation: pop 0.4s var(--motion-ease-emphasized, ease-out) both;
      animation-delay: calc(1.3s + var(--i) * 0.12s);
    }
    @keyframes draw {
      from {
        stroke-dashoffset: 1;
      }
    }
    @keyframes slide {
      from {
        opacity: 0;
        transform: translateX(-8px);
      }
    }
    @keyframes pop {
      from {
        opacity: 0;
        transform: scale(0.6);
      }
    }
  }
</style>
