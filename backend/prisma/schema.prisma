  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  logoKey          String?
  accentColor      String? // #rrggbb en minúsculas; null = color de la marca (10.2)
  storageUsedBytes BigInt    @default(0) // ver 9A.4
  settings         Json      @default("{}") // zona horaria, idioma y políticas (10.9)
  /// Límites que fija la empresa (StoredLimitsSchema de @spiderfolio/limits); vacío = sin límites.
  limits           Json      @default("{}")
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  roles                    Role[]
  memberships              Membership[]
  departments              Department[]
  departmentMembers        DepartmentMember[]
  invitations              Invitation[]
  auditLogs                AuditLog[]
  pinLogins                PinLogin[]
  spaces                   Space[]
  nodes                    Node[]
  permissions              Permission[]
  fileVersions             FileVersion[]
  uploadReservations       UploadReservation[]
  importJobs               ImportJob[]
  spaceStates              SpaceUserState[]
  downloadTokens           DownloadToken[]
  zipExports               ZipExport[]
  pageContents             PageContent[]
  formVersions             FormVersion[]
  formRecords              FormRecord[]
  formFiles                FormFile[]
  formSettings             FormSettings[]
  positions                Position[]
  expiries                 Expiry[]
  safetyItems              SafetyItem[]
  safetyDeliveries         SafetyDelivery[]
  safetyDeliveryLines      SafetyDeliveryLine[]
  safetyIncidents          SafetyIncident[]
  safetyActions            SafetyAction[]
  safetyCourses            SafetyCourse[]
  safetyTrainings          SafetyTraining[]
  safetySignSessions       SafetySignSession[]
  auditRooms               AuditRoom[]
  auditRoomItems           AuditRoomItem[]
  auditRoomCodes           AuditRoomCode[]
  auditRoomSessions        AuditRoomSession[]
  auditRoomAccesses        AuditRoomAccess[]
  safetyFitness            SafetyFitness[]
  caeCompanies             CaeCompany[]
  caeWorkers               CaeWorker[]
  caeRequirements          CaeRequirement[]
  caeDocuments             CaeDocument[]
  caeAccesses              CaeAccess[]
  caeInfoDeliveries        CaeInfoDelivery[]
  caeWorkPermits           CaeWorkPermit[]
  caePortalAccesses        CaePortalAccess[]
  safetyMonthStats         SafetyMonthStat[]
  safetyEmergencyRoles     SafetyEmergencyRole[]
  safetyEmergencyMembers   SafetyEmergencyMember[]
  safetyDrills             SafetyDrill[]
  safetyCommitteeMembers   SafetyCommitteeMember[]
  safetyMeetings           SafetyMeeting[]
  qualityNcs               QualityNc[]
  qualityActions           QualityAction[]
  qualityVerifications     QualityVerification[]
  qualityNcEvents          QualityNcEvent[]
  qualityNcCounters        QualityNcCounter[]
  qualityCcps              QualityCcp[]
  qualityHolds             QualityHold[]
  qualityAudits            QualityAudit[]
  qualityFindings          QualityFinding[]
  qualitySuppliers         QualitySupplier[]
  qualitySupplierDocs      QualitySupplierDoc[]
  qualitySupplierReviews   QualitySupplierReview[]
  qualityComplaints        QualityComplaint[]
  qualityMonthUnits        QualityMonthUnits[]
  qualityCrisisMembers     QualityCrisisMember[]
  qualityCrisisContacts    QualityCrisisContact[]
  qualityRecallTests       QualityRecallTest[]
  qualityPrps              QualityPrp[]
  qualityPrpChecks         QualityPrpCheck[]
  qualityProducts          QualityProduct[]
  qualityShelfLifeStudies  QualityShelfLifeStudy[]
  qualityLabels            QualityLabel[]
  qualitySamplingPoints    QualitySamplingPoint[]
  qualityLabResults        QualityLabResult[]
  qualityCulturePlans      QualityCulturePlan[]
  qualityCultureActivities QualityCultureActivity[]
  qualityCultureSurveys    QualityCultureSurvey[]
  qualityCultureAnswers    QualityCultureAnswer[]
  qualityCultureVoters     QualityCultureVoter[]
  qualityChanges           QualityChange[]
  qualityChangeCounters    QualityChangeCounter[]
  caePortalSessions        CaePortalSession[]
  caePortalUploads         CaePortalUpload[]
  pageImages               PageImage[]
  commentThreads           CommentThread[]
  comments                 Comment[]
  mentions                 Mention[]
  sharedSeen               SharedSeen[]
  notifications            Notification[]
  documentTypes            DocumentType[]
  controlledDocuments      ControlledDocument[]
  documentVersions         DocumentVersion[]
  approvals                Approval[]
  readRequirements         ReadRequirement[]
  documentVisits           DocumentVisit[]
  qrCodes                  QrCode[]
  emailSettings            WorkspaceEmail?
  contentChunks            ContentChunk[]
  usageCounters            UsageCounter[]
  usageCounterMembers      UsageCounterMember[]
  bianLimits               BianLimit[]
  bianFeedback             BianFeedback[]
  fileTexts                FileText[]
  readAcknowledgments      ReadAcknowledgment[]
  license                  WorkspaceLicense?
  pluginSettings           PluginSetting[]
  pluginSecrets            PluginSecret[]
  externalIdentities       ExternalIdentity[]
  ssoFlows                 SsoFlow[]
  oauthGrants              OAuthGrant[]
