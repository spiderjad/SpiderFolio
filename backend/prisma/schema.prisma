model Role {
  id           String     @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  base         SystemRole // nivel base que extiende
  capabilities String[] // ver 9.2
  isSystem     Boolean    @default(false) // los 4 de sistema no se borran

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, isSystem, base])
}

model Membership {
  id          String       @id @default(cuid())
  userId      String
  workspaceId String
  roleId      String
  status      MemberStatus @default(ACTIVE)
  seatType    SeatType     @default(FULL) // ver 9A.4
  jobTitle    String?
  /// The company's job position (Position; no FK, like Mention): one per person.
  positionId  String?
  /// The area the app opens in for this person (docs/spec/diseno.md 10.4.1); null = their
  /// department's, or Inicio.
  homeArea    HomeArea?
  createdAt   DateTime     @default(now())
  lastSeenAt  DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (no Restrict): se verifica al final de la sentencia, así purgar un workspace en
  // cascada no depende del orden de los triggers; borrar un rol en uso sigue fallando.
  role      Role      @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  departments      DepartmentMember[]
  pinLogin         PinLogin?
  permissions      Permission[]
  spaceStates      SpaceUserState[]
  downloadTokens   DownloadToken[]
  externalIdentity ExternalIdentity?

  @@unique([userId, workspaceId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, roleId])
  @@index([workspaceId, status])
  @@index([workspaceId, seatType])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, lastSeenAt])
  @@index([workspaceId, positionId])
}

/// Credencial de usuario + PIN de una membresía (7.6). Una fila por persona sin email; el
/// loginName es único dentro del workspace. Los contadores son por workspace.
model PinLogin {
  id             String    @id @default(cuid())
  workspaceId    String
  membershipId   String    @unique
  loginName      String
  pinHash        String
  failedAttempts Int       @default(0)
  lockCount      Int       @default(0) // bloqueos consecutivos: el tiempo se duplica
  lockedUntil    DateTime?
  pinChangedAt   DateTime  @default(now())
  pinChangedById String?
  createdAt      DateTime  @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, loginName])
  @@unique([membershipId, workspaceId])
}

model Department {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String?
  parentId    String? // subdepartamentos opcionales
  /// The area the app opens in for its members (docs/spec/diseno.md 10.4.1); null = Inicio.
  homeArea    HomeArea?
  createdAt   DateTime  @default(now())

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (no SetNull): SetNull también anularía workspaceId, que es parte de la clave.
  parent      Department?        @relation("DepartmentTree", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  children    Department[]       @relation("DepartmentTree")
  members     DepartmentMember[]
  permissions Permission[]
  spaces      Space[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, parentId])
}

/// A job position of the company (docs/spec/seguridad-salud.md, «Puestos»): assigned to people
/// (Membership.positionId) and used for obligations by position (readings, PPE, training).
model Position {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// Lowercase name: unique per company regardless of case.
  nameKey     String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
}

/// A date that expires on any kind of item, with notices (docs/spec/seguridad-salud.md, «Motor de
/// vencimientos»). `kind` names the item type (safety.ppe, safety.training…) and `subjectId` the item
/// in its own table (no FK). Notices go out at 8:00 in the company's zone when a threshold is reached.
model Expiry {
  id                      String    @id @default(cuid())
  workspaceId             String
  kind                    String
  subjectId               String
  /// The person it is about, if any (membership; no FK).
  membershipId            String?
  /// Who has to take care of it (membership; no FK).
  responsibleId           String?
  /// Or a department: its heads and deputies are told (no FK).
  responsibleDepartmentId String?
  /// A note about what to do (up to 500).
  note                    String?
  /// Who set it last (membership; no FK): told when no responsible can see the item.
  setById                 String?
  /// The company day it expires on.
  dueOn                   DateTime  @db.Date
  /// Days before dueOn to give notice (0 = the same day).
  noticeDays              Int[]     @default([30, 7, 0])
  /// The thresholds already notified (moving dueOn clears them).
  noticesSent             Int[]     @default([])
  /// Renewed, replaced or no longer applies: no more notices.
  resolvedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, subjectId])
  @@index([workspaceId, dueOn])
  @@index([workspaceId, membershipId])
}

/// Personal protective equipment of the company's catalog (docs/spec/seguridad-salud.md, «EPIs»).
/// Archived instead of deleted once it was handed out.
model SafetyItem {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  nameKey     String
  category    String?
  /// Handed out by size (gloves, footwear…).
  hasSizes    Boolean   @default(false)
  /// Months until it has to be replaced; null: no replacement date.
  lifeMonths  Int?
  /// The positions that require it («Le falta»).
  positionIds String[]
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     SafetyDeliveryLine[]

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
}

/// A PPE handout to a person, signed by whoever receives it. Never changed or deleted: voided with a
/// reason.
model SafetyDelivery {
  id            String    @id @default(cuid())
  workspaceId   String
  /// Who receives it (membership; no FK).
  membershipId  String
  /// Who hands it out (membership; no FK).
  deliveredById String
  deliveredAt   DateTime  @default(now())
  note          String?
  /// The recipient's signature, a PNG.
  signature     Bytes
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     SafetyDeliveryLine[]

  @@unique([id, workspaceId])
  @@index([workspaceId, membershipId, deliveredAt])
  @@index([workspaceId, deliveredAt])
}

/// One PPE of a handout: how many, the size and, with the item's life, the day to replace it.
model SafetyDeliveryLine {
  id          String    @id @default(cuid())
  workspaceId String
  deliveryId  String
  itemId      String
  quantity    Int
  size        String?
  /// Company day to replace it (handout + the item's life); null: no date.
  replaceOn   DateTime? @db.Date

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  delivery  SafetyDelivery @relation(fields: [deliveryId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  item      SafetyItem     @relation(fields: [itemId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@index([workspaceId, deliveryId])
  @@index([workspaceId, itemId])
}

/// An accident or incident (docs/spec/seguridad-salud.md, «Accidentes e incidentes»): what's structured
/// of a record of the module's base form, to filter and follow it. Health data: only `safety.health`.
model SafetyIncident {
  id           String    @id @default(cuid())
  workspaceId  String
  /// The FormRecord it comes from (no FK: records are never deleted).
  recordId     String
  /// leave (accident with sick leave), no_leave, incident, near_miss.
  type         String
  /// minor, serious, very_serious, fatal; null when it doesn't apply.
  severity     String?
  /// The company day it happened.
  occurredOn   DateTime  @db.Date
  place        String?
  /// Whoever was affected (membership; no FK), and their first department then.
  membershipId String?
  departmentId String?
  reportedById String
  /// OPEN or CLOSED.
  status       String    @default("OPEN")
  closedAt     DateTime?
  closedById   String?
  /// Days of sick leave (only the number: no medical data), for the severity index. safety.health.
  lostDays     Int?
  createdAt    DateTime  @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions   SafetyAction[]

  @@unique([workspaceId, recordId])
  @@unique([id, workspaceId])
  @@index([workspaceId, occurredOn])
  @@index([workspaceId, status])
}

/// A corrective measure of an incident: who does it and by when (an Expiry «safety.action»).
/// Where a preventive measure comes from (docs/spec/seguridad-salud.md, «Planificación de la actividad
/// preventiva»).
enum SafetyActionOrigin {
  INCIDENT
  RISK_ASSESSMENT
  INSPECTION
  OTHER
  DRILL
  COMMITTEE
}

enum SafetyActionPriority {
  LOW
  MEDIUM
  HIGH
}

/// A preventive or corrective measure: the planning of the preventive activity (Ley 31/1995, art. 16).
/// From an accident or incident (health data: only `safety.health` sees which), a risk assessment (the
/// EVR controlled document), an inspection (a non-conforming form record) or anything else.
model SafetyAction {
  id            String               @id @default(cuid())
  workspaceId   String
  origin        SafetyActionOrigin   @default(INCIDENT)
  /// With origin INCIDENT.
  incidentId    String?
  /// With origin RISK_ASSESSMENT: the EVR document (node; no FK).
  nodeId        String?
  /// With origin INSPECTION: the non-conforming form record (no FK: records are never deleted).
  recordId      String?
  /// With origin DRILL: the drill it comes from.
  drillId       String?
  /// With origin COMMITTEE: the committee meeting whose agreement it is.
  meetingId     String?
  description   String
  priority      SafetyActionPriority @default(MEDIUM)
  /// Estimated cost in cents of the company's currency, optional.
  estimatedCost Int?
  /// Membership; no FK.
  responsibleId String
  dueOn         DateTime             @db.Date
  doneAt        DateTime?
  doneById      String?
  note          String?
  createdById   String
  createdAt     DateTime             @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  drill     SafetyDrill?    @relation(fields: [drillId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  meeting   SafetyMeeting?  @relation(fields: [meetingId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  incident  SafetyIncident? @relation(fields: [incidentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, incidentId])
  @@index([workspaceId, responsibleId, doneAt])
  @@index([workspaceId, dueOn, id])
  @@index([workspaceId, origin, dueOn])
}

/// A course (docs/spec/seguridad-salud.md, «Formación»): a controlled document whose reading counts as
/// training, valid for some months. Who has to do it comes from the document's required readings.
model SafetyCourse {
  id             String   @id @default(cuid())
  workspaceId    String
  /// The controlled document (no FK, like Mention: trashing it hides the course).
  nodeId         String
  validityMonths Int?
  createdById    String
  createdAt      DateTime @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trainings    SafetyTraining[]
  signSessions SafetySignSession[]

  @@unique([workspaceId, nodeId])
  @@unique([id, workspaceId])
}

/// A training record: someone did a course (reading it, or in person). Never changed nor deleted.
model SafetyTraining {
  id           String    @id @default(cuid())
  workspaceId  String
  courseId     String
  membershipId String
  completedAt  DateTime
  /// READING (confirmed reading) or IN_PERSON (registered by whoever manages the module).
  source       String
  /// The company day it stops being valid (completion + the course's validity); null: never.
  validUntil   DateTime? @db.Date
  /// In person: the attendee's signature, a PNG.
  signature    Bytes?
  /// Signed on their own phone, in this session (null: on the trainer's tablet or by reading).
  sessionId    String?
  createdById  String
  createdAt    DateTime  @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    SafetyCourse @relation(fields: [courseId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([sessionId, membershipId])
  @@index([workspaceId, courseId, membershipId])
  @@index([workspaceId, membershipId])
}

/// In-person training signed by each attendee on their own phone (docs/spec/seguridad-salud.md): a QR
/// or link for one course and day, for the attendees chosen; open until it's closed or expires.
model SafetySignSession {
  id          String    @id @default(cuid())
  workspaceId String
  courseId    String
  /// The day of the training (as the tablet's attendance).
  completedOn DateTime  @db.Date
  /// Who has to sign (memberships; no FK).
  attendeeIds String[]
  /// Whoever gives the training: recorded as the one who registered each signature.
  createdById String
  expiresAt   DateTime
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    SafetyCourse @relation(fields: [courseId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, courseId])
}

/// Fitness for work (docs/spec/seguridad-salud.md, «Aptitud»): only fit, fit with restrictions or not
/// fit, and until when; never medical data. The latest one counts; earlier ones are history. Health
/// data: `safety.health` (each person sees theirs).
model SafetyFitness {
  id           String    @id @default(cuid())
  workspaceId  String
  membershipId String
  /// APT, APT_RESTRICTED or NOT_APT.
  status       String
  validUntil   DateTime? @db.Date
  /// Tasks they can't do (never causes nor diagnoses).
  restrictions String?
  createdById  String
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, membershipId, createdAt])
}

// ─── CAE: coordination of business activities (docs/spec/cae.md) ──────────────

/// CONTRACTOR: works for us; SUBCONTRACTOR: works for one of our contractors; CONCURRENT: shares the
/// site without a contract with us (RD 171/2004, ch. II).
enum CaeCompanyKind {
  CONTRACTOR
  SUBCONTRACTOR
  CONCURRENT
}

/// What a required document is about: the company or each of its workers.
enum CaeScope {
  COMPANY
  WORKER
}

/// Which companies a required document applies to (SUBCONTRACTOR goes with CONTRACTOR).
enum CaeAppliesTo {
  ALL
  CONTRACTOR
  CONCURRENT
}

/// An external company that works at the site (docs/spec/cae.md, «Modelo»). Archived instead of
/// deleted. Its authorization is computed (caeStatus), never stored.
model CaeCompany {
  id            String         @id @default(cuid())
  workspaceId   String
  name          String
  /// Lowercase name: unique per company regardless of case.
  nameKey       String
  /// CIF/NIF/RUT.
  taxId         String?
  kind          CaeCompanyKind
  /// The contractor a subcontractor depends on.
  parentId      String?
  /// What it does at the site.
  activity      String
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  /// The internal responsible person (membership; no FK).
  responsibleId String
  startsOn      DateTime?      @db.Date
  endsOn        DateTime?      @db.Date
  blockedAt     DateTime?
  blockedReason String?
  archivedAt    DateTime?
  /// Its folder inside «Contratas» (node; no FK: the folder can be trashed apart).
  folderId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (not SetNull): SetNull would also clear workspaceId, part of the key.
  parent         CaeCompany?       @relation("CaeCompanyTree", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  children       CaeCompany[]      @relation("CaeCompanyTree")
  workers        CaeWorker[]
  documents      CaeDocument[]
  accesses       CaeAccess[]
  infoDeliveries CaeInfoDelivery[]
  permits        CaeWorkPermit[]
  portalAccesses CaePortalAccess[]

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, name, id])
  @@index([workspaceId, responsibleId])
  @@index([workspaceId, parentId])
}

/// A worker of an external company: not a member (no account, no seat). No health data.
model CaeWorker {
  id            String    @id @default(cuid())
  workspaceId   String
  companyId     String
  name          String
  /// Identity document (only cae.manage and the responsible person see it whole).
  idNumber      String?
  task          String?
  blockedAt     DateTime?
  blockedReason String?
  archivedAt    DateTime?
  /// Their folder inside the company's, for their documents (node; no FK), created when first needed.
  folderId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CaeCompany    @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  documents CaeDocument[]
  accesses  CaeAccess[]

  @@unique([id, workspaceId])
  @@index([workspaceId, companyId, name, id])
  @@index([workspaceId, name, id])
}

/// A document the company asks of its contractors or of their workers (the catalog), ordered by
/// position. Archived instead of deleted.
model CaeRequirement {
  id             String       @id @default(cuid())
  workspaceId    String
  name           String
  nameKey        String
  scope          CaeScope
  /// To propose the expiry date of a document.
  validityMonths Int?
  appliesTo      CaeAppliesTo @default(ALL)
  /// Missing, it doesn't authorize.
  required       Boolean      @default(true)
  archivedAt     DateTime?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents CaeDocument[]

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, scope, position, id])
}

enum CaeDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A document given for a requirement (docs/spec/cae.md, «Modelo»): a file in the company's folder.
/// The ACCEPTED one without supersededAt is the current one of its (requirement, company, worker); the
/// rest are history. Never deleted.
model CaeDocument {
  id             String            @id @default(cuid())
  workspaceId    String
  requirementId  String
  companyId      String
  /// With a WORKER requirement.
  workerId       String?
  /// The file (node; no FK: it can go to the trash apart).
  nodeId         String
  validUntil     DateTime?         @db.Date
  status         CaeDocumentStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  /// A newer document of the same requirement was accepted.
  supersededAt   DateTime?
  /// Uploaded by the contractor through its portal (createdById is then whoever issued that access).
  portalAccessId String?
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requirement  CaeRequirement   @relation(fields: [requirementId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  company      CaeCompany       @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  portalAccess CaePortalAccess? @relation(fields: [portalAccessId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)
  worker       CaeWorker?       @relation(fields: [workerId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, workspaceId])
  @@index([workspaceId, companyId, workerId, requirementId, createdAt])
  @@index([workspaceId, workerId, requirementId, createdAt])
  @@index([workspaceId, status, createdAt, id])
}

/// Cargo de una persona dentro de un departamento. Un solo HEAD por departamento (índice único
/// parcial en la migración, que Prisma no puede expresar) y uno o más DEPUTY. HEAD y DEPUTY
/// tienen el alcance ".own" sobre el departamento y sus subdepartamentos.
enum DepartmentPosition {
  HEAD
  DEPUTY
  MEMBER
}

model DepartmentMember {
  departmentId String
  membershipId String
  workspaceId  String
  position     DepartmentPosition @default(MEMBER)

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([departmentId, membershipId])
  @@index([membershipId])
  @@index([workspaceId])
}

model Invitation {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String // en minúsculas
  roleId        String
  seatType      SeatType
  departmentIds String[]
  tokenHash     String    @unique // SHA-256; el token solo viaja en el email
  invitedById   String // userId de quien invita (sin FK: borrar la cuenta no borra la invitación)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@index([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, acceptedAt, revokedAt, expiresAt])
}

/// Append-only. workspaceId null = evento global (ej. login fallido sin workspace).
model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String // "auth.login", "node.move", "permission.grant"…
  entityType  String?
  entityId    String?
  ip          String?
  userAgent   String?
  metadata    Json? // nunca contenido ni secretos
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
}

/// Nivel de acceso a contenido (8.1): MANAGE > EDIT > COMMENT > VIEW.
enum AccessLevel {
  MANAGE
  EDIT
  COMMENT
  VIEW
}

enum NodeType {
  FOLDER
  FILE
  PAGE
  /// A form (docs/spec/formularios.md): its fields live in FormVersion.
  FORM
}

/// Espacio: la raíz de un árbol de carpetas, archivos y páginas. Privado = solo con permiso
/// explícito. El nombre es único por workspace entre los no archivados (índice parcial en la
/// migración) comparando `nameKey` (NFC y minúsculas).
model Space {
  id              String      @id @default(cuid())
  workspaceId     String
  name            String
  nameKey         String
  icon            String?
  /// #rrggbb en minúsculas; null = el del departamento dueño o, sin él, el color de marca.
  color           String?
  description     String?
  isPrivate       Boolean     @default(false)
  /// Confidencial: además de privado, los administradores no entran solos (solo el propietario
  /// del workspace, el jefe y subjefe del departamento, sus miembros y quien se agregue). Implica
  /// `isPrivate` (CHECK en la migración).
  isConfidential  Boolean     @default(false)
  createdById     String // id de la membresía (sin FK: quitar a la persona no borra el espacio)
  createdAt       DateTime    @default(now())
  archivedAt      DateTime?
  /// Espacio de un departamento (null = de la empresa). Sus jefes y subjefes lo gestionan, y sus
  /// miembros entran con `departmentLevel` (los de sus subdepartamentos, solo con `includeSubareas`).
  departmentId    String?
  /// Nivel de los miembros del departamento: EDIT (por defecto) o VIEW.
  departmentLevel AccessLevel @default(EDIT)
  /// Extiende el acceso de miembros a los subdepartamentos (los jefes de áreas superiores gestionan
  /// el espacio igual).
  includeSubareas Boolean     @default(false)
  /// The app area it's listed in (docs/spec/diseno.md 10.4.1): the Wiki by default; the Prevention
  /// module's space is PREVENTION.
  area            SpaceArea   @default(WIKI)

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // NoAction (no SetNull): SetNull también anularía workspaceId. Al borrar un departamento, el
  // servicio deja sus espacios como espacios de la empresa antes de borrarlo.
  department    Department?      @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  nodes         Node[]
  permissions   Permission[]
  userStates    SpaceUserState[]
  notifications Notification[]

  @@unique([id, workspaceId])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, departmentId])
}

/// Lo personal de cada persona sobre un espacio: si lo marcó como favorito y cuándo lo abrió por
/// última vez (para "Recientes"). No da ni quita acceso.
model SpaceUserState {
  id               String    @id @default(cuid())
  workspaceId      String
  spaceId          String
  membershipId     String
  favorite         Boolean   @default(false)
  /// Orden de los favoritos de la persona (menor primero); null = sin orden elegido, al final.
  favoritePosition Int?
  visitedAt        DateTime?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space      Space      @relation(fields: [spaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([spaceId, membershipId])
  @@index([workspaceId, membershipId, favorite])
  @@index([workspaceId, membershipId, visitedAt])
}

/// Árbol único: carpetas, archivos y páginas son nodos. Dos hermanos no pueden llamarse igual
/// (índice único parcial en la migración sobre `nameKey`, entre los que no están en la papelera).
model Node {
  id             String                   @id @default(cuid())
  workspaceId    String
  spaceId        String
  parentId       String? // FOLDER (o PAGE más adelante); null = raíz del espacio
  type           NodeType
  name           String
  nameKey        String // NFC y minúsculas: la comparación de nombres repetidos
  icon           String?
  /// Portada de una página: uno de los colores predefinidos (COVERS en nodes.schemas.ts).
  cover          String?
  position       String // índice fraccional dentro de la carpeta
  inheritAccess  Boolean                  @default(true)
  createdById    String // id de la membresía (sin FK, como en Space)
  updatedById    String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  /// App that made the last change for updatedById ("Claude"), valid while updatedViaAt == updatedAt.
  updatedVia     String?
  updatedViaAt   DateTime?
  trashedAt      DateTime? // papelera (30 días)
  trashRootId    String? // el nodo que se borró de verdad: restaurarlo trae a todo su subárbol
  /// Texto que se indexa para la búsqueda (título aparte): lo mantienen los triggers de la base.
  searchText     String                   @default("")
  /// Índice de texto completo (es_unaccent): título y código pesan más que el cuerpo.
  searchTsv      Unsupported("tsvector")?
  // Solo FILE: la versión vigente y una copia de sus datos para los listados.
  currentVersion Int                      @default(0)
  mimeType       String?
  sizeBytes      BigInt?

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space               Space                @relation(fields: [spaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  parent              Node?                @relation("NodeTree", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  children            Node[]               @relation("NodeTree")
  permissions         Permission[]
  versions            FileVersion[]
  pageContent         PageContent?
  formVersions        FormVersion[]
  formRecords         FormRecord[]
  formFiles           FormFile[]
  formSettings        FormSettings?
  pageImages          PageImage[]
  threads             CommentThread[]
  mentions            Mention[]
  sharedSeen          SharedSeen[]
  notifications       Notification[]
  controlled          ControlledDocument?
  documentVersions    DocumentVersion[]
  approvals           Approval[]
  readRequirements    ReadRequirement[]
  documentVisits      DocumentVisit[]
  contentChunks       ContentChunk[]
  qrCodes             QrCode[]
  fileTexts           FileText[]
  readAcknowledgments ReadAcknowledgment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, spaceId, parentId])
  @@index([workspaceId, trashedAt])
  @@index([workspaceId, trashRootId])
  @@index([searchTsv], type: Gin)
}

/// Permiso sobre un espacio O un nodo, para una persona O un departamento (CHECK en la
/// migración). Los departamentos hijos heredan del padre al resolver (8.2).
model Permission {
  id              String      @id @default(cuid())
  workspaceId     String
  spaceId         String?
  nodeId          String?
  membershipId    String?
  departmentId    String?
  /// Toda la empresa: todos los miembros activos (sin invitados externos). Ni persona ni departamento.
  everyone        Boolean     @default(false)
  level           AccessLevel
  grantedById     String // id de la membresía de quien lo dio
  expiresAt       DateTime? // accesos temporales
  /// Solo para un departamento: el acceso llega también a los miembros de sus subdepartamentos.
  includeSubareas Boolean     @default(false)
  createdAt       DateTime    @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space      Space?      @relation(fields: [spaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  node       Node?       @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  department Department? @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, spaceId])
  @@index([workspaceId, nodeId])
  @@index([workspaceId, membershipId])
  @@index([workspaceId, departmentId])
}

/// Cada subida de un archivo. La clave del objeto es aleatoria (nunca el nombre original):
/// workspaceId/nodeId/version-aleatorio. La cuota cuenta las no purgadas (9A.4).
model FileVersion {
  id           String    @id @default(cuid())
  workspaceId  String
  nodeId       String
  version      Int
  storageKey   String    @unique
  fileName     String
  mimeType     String // el detectado por magic bytes, no el declarado
  sizeBytes    BigInt
  checksum     String // SHA-256 en hexadecimal
  uploadedById String // id de la membresía (sin FK)
  createdAt    DateTime  @default(now())
  purgedAt     DateTime? // el objeto ya se borró de S3
  trashedAt    DateTime? // en la papelera de versiones (fileVersionsKept del plan): 30 días

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([workspaceId, purgedAt])
  @@index([workspaceId, trashedAt])
  @@index([workspaceId, checksum])
}

/// Subida en curso: reserva cuota (usado + reservado + nuevo <= límite) y recuerda qué hay que
/// crear al confirmar. Vence a la hora; un job aborta lo que quedó a medias.
model UploadReservation {
  id          String   @id @default(cuid())
  workspaceId String
  bytes       BigInt
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  createdById String // id de la membresía
  spaceId     String
  parentId    String? // dónde queda el archivo nuevo
  nodeId      String // el archivo (nuevo o existente, si es una versión nueva)
  isNewNode   Boolean
  version     Int
  name        String // nombre final (ya resuelto el conflicto)
  conflict    String // reject | keep_both: qué hacer si al confirmar el nombre ya está tomado
  storageKey  String   @unique
  mimeType    String // el declarado (el real se detecta al confirmar)
  multipartId String? // uploadId de S3 en subidas por partes
  partSize    Int?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([expiresAt])
}

/// Importación de un ZIP ya subido (un archivo del árbol): el worker lo descomprime en el destino.
/// El resumen (importados, omitidos con motivo, duplicados por checksum) queda acá para la pantalla.
model ImportJob {
  id          String    @id @default(cuid())
  workspaceId String
  spaceId     String
  parentId    String? // carpeta donde se descomprime (o donde se crea la carpeta nueva)
  nodeId      String // el archivo ZIP
  createdById String // id de la membresía
  newFolder   Boolean // descomprimir dentro de una carpeta nueva con el nombre del ZIP
  status      String // PENDING | RUNNING | DONE | FAILED
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  summary     Json?
  error       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdById, createdAt])
  @@index([status, createdAt])
}

/// Descarga directa de un ZIP: un token opaco (solo se guarda su hash), de un solo uso y muy corta
/// duración, que se canjea con un enlace normal. Los permisos se vuelven a resolver al canjearlo.
model DownloadToken {
  id           String    @id @default(cuid())
  workspaceId  String
  membershipId String
  spaceId      String
  nodeIds      Json // los ids elegidos (el contenido se vuelve a calcular al canjear)
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([expiresAt])
}

/// ZIP grande generado en segundo plano: se guarda en el bucket de sistema 7 días (no cuenta para
/// la cuota) y se avisa por email con un enlace temporal (solo se guarda su hash).
model ZipExport {
  id           String    @id @default(cuid())
  workspaceId  String
  spaceId      String
  membershipId String // quien lo pidió
  nodeIds      Json
  status       String // PENDING | RUNNING | DONE | FAILED
  fileName     String
  storageKey   String?
  sizeBytes    BigInt?
  linkHash     String?   @unique
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?
  expiresAt    DateTime?
  error        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, membershipId, createdAt])
  @@index([expiresAt])
}

/// One version of a form's template (node FORM): its fields, validated by modules/forms. Saving a changed
/// template adds a version; Node.currentVersion is the latest. Versions are never edited or deleted (a
/// record keeps the version it was filled with).
model FormVersion {
  id          String   @id @default(cuid())
  workspaceId String
  nodeId      String
  version     Int
  fields      Json
  /// Membership that saved it.
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([workspaceId])
}

/// A filled-in form (docs/spec/formularios.md): who, when, from where, the answers and the version
/// they were filled with. Never edited or deleted: a mistaken one is voided (with its reason) and kept.
model FormRecord {
  id            String    @id @default(cuid())
  workspaceId   String
  nodeId        String
  /// The template version it was filled with (FormVersion.version of this form).
  version       Int
  answers       Json
  /// Ids of the fields whose answer is non-conforming (computed by the server when it's sent).
  nonConforming String[]
  /// «app» or «qr»: where it was filled in from.
  source        String
  /// A periodic form's period it counts for, in the company's zone («2026-10-30», the week's Monday
  /// or «2026-10»); null if the form isn't periodic.
  periodKey     String?
  /// Membership that filled it in.
  submittedById String
  submittedAt   DateTime  @default(now())
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node       @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  files     FormFile[]

  @@unique([id, workspaceId])
  @@index([workspaceId, nodeId, submittedAt])
  @@index([workspaceId, submittedById])
  @@index([workspaceId, nodeId, periodKey])
}

/// How a form runs (docs/spec/formularios.md, phase 3): who's in charge (told about non-conformities and
/// periods left without a record) and, for periodic forms, how often and who fills it in. Not part of the
/// template's versions: changing it doesn't change what was filled in.
model FormSettings {
  nodeId                  String           @id
  workspaceId             String
  /// A person in charge, or a department whose heads are; neither: the heads of the space's department
  /// (or whoever created the form).
  responsibleMembershipId String?
  responsibleDepartmentId String?
  /// none | daily | weekly | monthly
  frequency               String           @default("none")
  /// daily: the ISO weekdays it's due on (1 = Monday … 7 = Sunday).
  weekdays                Int[]
  /// Who fills it in each period (one record per period, from any of them).
  assigneeMembershipIds   String[]
  assigneeDepartmentIds   String[]
  /// The fields shown as columns in the records list (empty: the first number, choice or yes/no ones).
  listFieldIds            String[]         @default([])
  /// Food quality (docs/spec/calidad.md): a non-conforming record opens a nonconformity by itself.
  qualityAutoNc           Boolean          @default(false)
  qualitySeverity         QualitySeverity?
  /// Membership in charge of the nonconformities it opens (none: the form's first responsible).
  qualityOwnerId          String?
  updatedAt               DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, workspaceId])
  @@index([workspaceId, frequency])
}

/// A photo or a signature of a record: uploaded while filling it in (recordId null), confirmed by its
/// real bytes and tied to the record when it's sent. Counts for the company's storage. The ones never
/// tied to a record are swept after a day (form-file-sweep.ts).
model FormFile {
  id          String    @id @default(cuid())
  workspaceId String
  nodeId      String
  fieldId     String
  recordId    String?
  storageKey  String    @unique
  mimeType    String
  sizeBytes   BigInt
  /// Membership that uploaded it.
  createdById String
  createdAt   DateTime  @default(now())
  /// null: requested, not uploaded yet.
  confirmedAt DateTime?

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node        @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  record    FormRecord? @relation(fields: [recordId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, recordId])
  @@index([confirmedAt, createdAt])
}

/// El texto de una página (nodo PAGE): documento Tiptap/ProseMirror validado por packages/content.
/// `revision` sube en cada guardado y permite detectar ediciones simultáneas (control optimista).
model PageContent {
  nodeId       String    @id
  workspaceId  String
  content      Json
  revision     Int       @default(1)
  /// Texto plano para búsquedas futuras.
  textPlain    String    @default("")
  updatedById  String // id de la membresía
  updatedAt    DateTime  @updatedAt
  /// As in Node: the app behind the last change, valid while updatedViaAt == updatedAt.
  updatedVia   String?
  updatedViaAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, workspaceId])
  @@index([workspaceId])
}

/// Imagen dentro de una página: cuenta para la cuota de almacenamiento (9A.4).
model PageImage {
  id          String    @id @default(cuid())
  workspaceId String
  nodeId      String
  storageKey  String    @unique
  mimeType    String
  sizeBytes   BigInt
  createdById String // id de la membresía
  createdAt   DateTime  @default(now())
  /// null: subida sin confirmar todavía.
  confirmedAt DateTime?
  /// Última vez que la limpieza nocturna vio que sigue en uso (null: nunca).
  checkedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, nodeId])
}

/// Hilo de comentarios de una página. Con `quote` está anclado a un fragmento del texto (la marca
/// `commentThread` del documento lleva el id del hilo); sin `quote` es un comentario general.
model CommentThread {
  id           String    @id @default(cuid())
  workspaceId  String
  nodeId       String
  quote        String?
  status       String    @default("OPEN") // OPEN | RESOLVED
  createdById  String // id de la membresía
  createdAt    DateTime  @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  comments  Comment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, nodeId, status, createdAt])
}

model Comment {
  id          String    @id @default(cuid())
  workspaceId String
  threadId    String
  authorId    String // id de la membresía
  body        String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  /// Borrado con respuestas de otros: queda el hueco, sin texto.
  deletedAt   DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  thread    CommentThread @relation(fields: [threadId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, threadId, createdAt])
}

/// Una persona mencionada con @ en el texto de una página (`commentId` null) o en un comentario.
/// Solo avisa: nunca da acceso. `notifiedAt` null = todavía sin aviso (no tenía acceso a la página).
model Mention {
  id          String    @id @default(cuid())
  workspaceId String
  nodeId      String
  commentId   String?
  mentionedId String // id de la membresía mencionada
  createdById String // id de la membresía de quien menciona
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, nodeId, mentionedId])
}

/// Qué elementos compartidos ya abrió cada persona («Nuevo» en Compartido conmigo). Una fila por
/// persona y elemento; si el acceso se vuelve a dar después de `seenAt`, el elemento vuelve a ser nuevo.
model SharedSeen {
  id           String   @id @default(cuid())
  workspaceId  String
  membershipId String // id de la membresía (sin FK, como Mention)
  nodeId       String
  seenAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([membershipId, nodeId])
  @@index([workspaceId, membershipId])
}

/// Avisos de cada persona (campana): alguien compartió algo con ella, o un acceso suyo está por vencer.
/// Es de quien la recibe (membershipId, sin FK como Mention): nadie lee las de otra persona.
model Notification {
  id           String    @id @default(cuid())
  workspaceId  String
  membershipId String
  /// "shared" | "expiring"
  kind         String
  /// Quién compartió (membresía), si aplica.
  actorId      String?
  spaceId      String?
  nodeId       String?
  permissionId String?
  /// Invitación de la que se avisa («invitation_by_leader»); sin FK: si la invitación se borra, el aviso queda sin detalle.
  invitationId String?
  /// Número de versión del documento al que se refiere (avisos de documentos controlados).
  version      Int?
  /// El vencimiento del que se avisa («expiring»).
  expiresAt    DateTime?
  /// The Expiry an «expiry_due» notice is about (no FK: if it goes, the notice stays without detail).
  expiryId     String?
  /// Evita avisar dos veces lo mismo (el job diario puede repetir).
  dedupeKey    String?
  /// Detail without free text: the reason code of an «email_failing» notice (AUTH, CONNECTION…).
  detail       String?
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space     Space?    @relation(fields: [spaceId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  node      Node?     @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([membershipId, dedupeKey])
  @@index([workspaceId, membershipId, createdAt])
}

enum DocStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  OBSOLETE
  /// Descartada por quien la revisó: queda en el historial, no se publica.
  REJECTED
}

/// Tipo de documento controlado (PRC, INS, FOR, POL, MAN…): numeración y regla de aprobadores.
model DocumentType {
  id           String @id @default(cuid())
  workspaceId  String
  code         String // PRC, INS…
  name         String
  prefix       String
  padding      Int    @default(3)
  /// Próximo número; se toma con un UPDATE (sin saltos ni repetidos).
  nextNumber   Int    @default(1)
  reviewMonths Int    @default(12)
  /// Quiénes aprueban por defecto: OWNER_HEAD = jefe del departamento responsable.
  approverRule String @default("OWNER_HEAD")
  position     Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

/// Una página o un archivo que pasó a ser documento controlado (1:1 con el nodo).
model ControlledDocument {
  id                String    @id @default(cuid())
  workspaceId       String
  nodeId            String    @unique
  code              String
  docType           String // código del tipo (PRC…)
  /// Departamento responsable (sin FK, como Mention: su baja no bloquea).
  ownerDepartmentId String?
  reviewDueAt       DateTime?
  /// Número de la versión vigente; null si todavía no hay ninguna publicada.
  publishedVersion  Int?
  createdById       String
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@unique([nodeId, workspaceId])
  @@index([workspaceId, ownerDepartmentId])
}

/// Cada versión de un documento controlado. Una sola PUBLISHED por documento (índice parcial en la
/// migración); la anterior pasa a OBSOLETE y nunca se borra (es evidencia de auditoría).
model DocumentVersion {
  id            String    @id @default(cuid())
  workspaceId   String
  nodeId        String
  version       Int
  status        DocStatus @default(DRAFT)
  title         String
  changeNote    String?
  /// Página: instantánea del texto al enviar a revisión (null mientras es borrador).
  content       Json?
  /// Archivo: número de FileVersion que esta versión controla.
  fileVersion   Int?
  checksum      String?
  createdById   String
  createdAt     DateTime  @default(now())
  submittedAt   DateTime?
  /// Quién la envió a revisión (membresía).
  submittedById String?
  approvedAt    DateTime?
  publishedAt   DateTime?
  effectiveAt   DateTime?
  obsoletedAt   DateTime?
  /// PDF controlado generado al publicar (parte 5).
  pdfKey        String?
  /// Texto plano de la versión (páginas): lo que se indexa cuando está vigente.
  textPlain     String?
  /// Cambio menor: al publicarla no se pidió nueva lectura (las lecturas anteriores siguen valiendo).
  minorChange   Boolean   @default(false)
  /// Motivo del cambio, escrito al publicar (lo ve quien debe releer).
  changeReason  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([workspaceId, nodeId, status])
}

/// Una aprobación pedida sobre una versión. `round` es el momento en que se envió a revisión: si se
/// rechaza y se vuelve a enviar, las del envío anterior quedan como historial.
model Approval {
  id            String    @id @default(cuid())
  workspaceId   String
  nodeId        String
  version       Int
  /// Membresía de quien debe aprobar (sin FK, como Mention).
  approverId    String
  round         DateTime
  /// APPROVED | CHANGES_REQUESTED | REJECTED; null mientras está pendiente.
  decision      String?
  comment       String?
  decidedAt     DateTime?
  /// Lo aprobó quien también la envió (solo si el workspace lo permite).
  selfApproved  Boolean   @default(false)
  /// Quién envió a revisión en esta ronda (membresía).
  submittedById String?
  /// El texto de la página tal como se envió en esta ronda (para ver qué cambió desde su revisión).
  snapshot      Json?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, version, approverId, round])
  @@index([workspaceId, approverId, decision])
}

/// Quién debe leer una versión de un documento controlado: un departamento (con o sin subáreas) o una
/// persona. Los dos únicos parciales (por departamento y por persona) están en la migración.
model ReadRequirement {
  id              String    @id @default(cuid())
  workspaceId     String
  nodeId          String
  version         Int
  departmentId    String?
  /// Membresía (sin FK, como Mention).
  membershipId    String?
  /// A job position: everyone active with it (docs/spec/seguridad-salud.md; no FK).
  positionId      String?
  includeSubareas Boolean   @default(false)
  dueAt           DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, nodeId, version])
}

/// «Leí y comprendo»: una por persona y versión.
model ReadAcknowledgment {
  id           String   @id @default(cuid())
  workspaceId  String
  nodeId       String
  version      Int
  membershipId String
  readAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, version, membershipId])
  @@index([workspaceId, membershipId])
}

/// Último paso de cada persona por cada documento (páginas y archivos): solo la última visita, y se
/// conservan las 50 más recientes por persona. Es privado: nadie lee las visitas de otra persona.
model DocumentVisit {
  id           String   @id @default(cuid())
  workspaceId  String
  /// Membresía (sin FK, como Mention).
  membershipId String
  nodeId       String
  visitedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([membershipId, nodeId])
  @@index([workspaceId, membershipId, visitedAt])
}

/// Código QR de un documento: la URL corta /q/:token abre siempre la versión vigente. El token es
/// aleatorio y no lleva datos del documento. Público = sin sesión, solo ese documento, solo lectura.
model QrCode {
  id          String    @id @default(cuid())
  workspaceId String
  nodeId      String
  token       String    @unique
  isPublic    Boolean   @default(false)
  /// Membresía de quien lo generó (sin FK, como Mention).
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  /// Veces que se abrió. Contador a secas: no guarda quién ni desde dónde.
  scans       Int       @default(0)
  lastScanAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, nodeId, createdAt])
}

/// Texto extraído de un PDF o DOCX subido (para la búsqueda). Una fila por versión del archivo.
model FileText {
  id          String   @id @default(cuid())
  workspaceId String
  nodeId      String
  version     Int
  text        String
  /// OK | EMPTY (sin texto, por ejemplo un escaneo) | FAILED
  status      String   @default("OK")
  extractedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, version])
  @@index([workspaceId, nodeId])
}

/// Remitente de email propio de la empresa (una fila por workspace). La contraseña SMTP va cifrada
/// (AES-256-GCM, el workspaceId como dato autenticado) y no sale nunca por la API. Para activarlo hace
/// falta una prueba aprobada de esta misma configuración (`testedFingerprint`).
model WorkspaceEmail {
  id                  String       @id @default(cuid())
  workspaceId         String       @unique
  mode                EmailMode    @default(SMTP)
  status              EmailStatus  @default(DRAFT)
  fromName            String?
  fromEmail           String?
  replyTo             String?
  smtpHost            String?
  smtpPort            Int?
  smtpSecurity        SmtpSecurity @default(STARTTLS)
  smtpUser            String?
  /// `v1:iv:tag:texto` en base64; null = sin contraseña.
  smtpPassEnc         String?
  /// Huella de la configuración que pasó la prueba y cuándo.
  testedFingerprint   String?
  testedAt            DateTime?
  lastError           String?
  lastErrorAt         DateTime?
  /// Fallos de envío seguidos con el SMTP propio (3 lo desactivan).
  consecutiveFailures Int          @default(0)
  lastFallbackAlertAt DateTime?
  /// Fase B: dominio verificado por el proveedor de email.
  domain              String?
  domainProviderRef   String?
  domainStatus        String?
  domainRecords       Json?
  domainVerifiedAt    DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Fragmentos de la versión vigente para el asistente Bian (búsqueda y citas). Solo texto: sin
/// embeddings por ahora (pgvector se aprueba junto con ellos). `tsv` es una columna generada (la crea
/// la migración) y `textNorm` también: el `@default(dbgenerated())` solo le dice a Prisma que la
/// base les pone el valor, para que `migrate dev` no intente cambiarlas (Postgres no lo permite).
/// Nunca se escriben desde Prisma.
model ContentChunk {
  id          String                   @id @default(cuid())
  workspaceId String
  nodeId      String
  /// Versión del documento controlado a la que pertenece; null en páginas y archivos sin control.
  version     Int?
  seq         Int
  /// Encabezado de la sección (ancla para el enlace al fragmento); null si no hay.
  heading     String?
  text        String
  contentHash String
  tokens      Int
  tsv         Unsupported("tsvector")? @default(dbgenerated())
  /// Texto sin acentos y en minúsculas (columna generada) para la búsqueda por trigramas.
  textNorm    String?                  @default(dbgenerated())
  createdAt   DateTime                 @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([nodeId, seq])
  @@index([workspaceId, nodeId])
  @@index([tsv], type: Gin)
}

/// Consultas a Bian por mes calendario (UTC); el total lo fija la empresa (`aiQueriesPerMonth` de Workspace.limits).
model UsageCounter {
  workspaceId String
  periodStart DateTime
  aiQueries   Int      @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, periodStart])
}

/// Consultas a Bian por persona y período (además del total de la empresa). Solo cantidades.
/// `membershipId` sin FK, como Mention: la baja de la persona no bloquea.
model UsageCounterMember {
  workspaceId  String
  membershipId String
  periodStart  DateTime
  aiQueries    Int      @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([membershipId, periodStart])
  @@index([workspaceId, periodStart])
}

enum BianLimitScope {
  GENERAL
  DEPARTMENT
  PERSON
}

enum BianLimitMode {
  /// Un número de consultas por mes.
  LIMIT
  UNLIMITED
  /// Sin acceso a Bian (solo en excepciones por persona).
  BLOCKED
}

/// Límite mensual de consultas a Bian por persona: uno general, excepciones por departamento (por
/// cada persona de ese departamento) y por persona. Precedencia: persona > departamento > general,
/// siempre dentro del total de la empresa. `departmentId` y `membershipId` sin FK, como Mention.
model BianLimit {
  id           String         @id @default(cuid())
  workspaceId  String
  scope        BianLimitScope
  departmentId String?
  membershipId String?
  mode         BianLimitMode
  /// Solo con LIMIT.
  limit        Int?
  updatedAt    DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
}

/// Nodos cuyo contenido cambió y hay que reindexar para Bian. Lo llenan triggers de la base (sin tocar el
/// código de cada módulo) y lo vacía el job `bian-index` del worker. Una fila por nodo; sin FK a propósito
/// (el nodo puede haberse borrado cuando el job llega).
model ContentChunkDirty {
  nodeId      String   @id
  workspaceId String
  markedAt    DateTime @default(now())

  @@index([markedAt])
}

/// Valoración de una respuesta de Bian (👍/👎). Guarda solo la valoración, la fecha y los ids de los
/// documentos citados: nunca la pregunta, la respuesta ni quién la dio.
model BianFeedback {
  id          String   @id @default(cuid())
  workspaceId String
  /// UP | DOWN
  rating      String
  /// Solo con DOWN y opcional: INCORRECT | INCOMPLETE | WRONG_SOURCE | OTHER.
  reason      String?
  nodeIds     String[]
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ─── Plugins (docs/spec/plugins.md) ─────────────────────────────────────────

/// Licencia firmada (Ed25519) que activa plugins en el workspace. Se verifica sin conexión en cada
/// uso: acá solo se guarda el token tal como se cargó.
model WorkspaceLicense {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  token        String
  /// Membresía que la cargó (null si se borró).
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Ajustes de un plugin en un workspace (clave → JSON). Se conservan aunque el plugin se desactive.
model PluginSetting {
  id          String   @id @default(cuid())
  workspaceId String
  pluginId    String
  key         String
  value       Json
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pluginId, key])
}

/// Secret of a plugin in a workspace (a service account password, a client secret), encrypted with
/// EMAIL_ENCRYPTION_KEY and bound to the workspace, the plugin and the key. Never sent to the app.
model PluginSecret {
  id          String   @id @default(cuid())
  workspaceId String
  pluginId    String
  key         String
  valueEnc    String
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pluginId, key])
}

/// A member's account in the company's directory (docs/spec/plugins.md «Directorio de la empresa»),
/// linked by the directory's stable id (objectGUID, oid), never by email. One per membership.
model ExternalIdentity {
  id                   String    @id @default(cuid())
  workspaceId          String
  membershipId         String    @unique
  pluginId             String
  /// Provider id inside the plugin.
  provider             String
  externalId           String
  /// The directory suspended the membership (and may reactivate it); one suspended by an
  /// administrator stays as it is.
  suspendedByDirectory Boolean   @default(false)
  lastLoginAt          DateTime?
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([membershipId, workspaceId])
  @@unique([workspaceId, pluginId, provider, externalId])
  @@index([workspaceId, pluginId, id])
}

/// Sign-in with a redirect provider (OIDC) in progress: the state, PKCE verifier and nonce, bound
/// to the workspace and to the browser that started it (hash of a cookie), for a few minutes.
model SsoFlow {
  id           String    @id @default(cuid())
  workspaceId  String
  pluginId     String
  provider     String
  stateHash    String    @unique
  browserHash  String
  codeVerifier String
  nonce        String
  next         String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// An application connected over OAuth (docs/spec/conector-mcp.md): registered dynamically (RFC 7591)
/// or identified by its Client ID Metadata Document (clientId is then that HTTPS URL, re-read when
/// `fetchedAt` is old). Not a company's: the same Claude client serves every company.
model OAuthClient {
  id           String    @id @default(cuid())
  /// What the client sends as client_id: a random id (registered) or its metadata document's URL.
  clientId     String    @unique
  kind         String // REGISTERED | METADATA_DOCUMENT
  clientName   String
  redirectUris String[]
  fetchedAt    DateTime?
  createdAt    DateTime  @default(now())

  grants OAuthGrant[]

  @@index([createdAt])
}

/// A connection: a person lets a client act for them in one company, with these scopes. Revoked by
/// the person, the company's owner or administrators, or by reusing a rotated refresh token.
model OAuthGrant {
  id          String    @id @default(cuid())
  clientId    String
  userId      String
  workspaceId String
  scopes      String[]
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  client    OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokens    OAuthToken[]

  @@index([workspaceId, revokedAt])
  @@index([userId, revokedAt])
}

/// Authorization codes, access and refresh tokens of a connection: only their SHA-256 hashes. A
/// refresh token is replaced on every use (same familyId); presenting a replaced one revokes the grant.
model OAuthToken {
  id            String    @id @default(cuid())
  grantId       String
  type          String // CODE | ACCESS | REFRESH
  tokenHash     String    @unique
  familyId      String?
  /// Authorization code only: the PKCE challenge (S256) and the redirect URI it was issued for.
  codeChallenge String?
  redirectUri   String?
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([expiresAt])
}

/// An audit room (docs/spec/salas-de-auditoria.md): read-only, for one external auditor, until it expires
/// (30 days at most) or is revoked. The auditor has no account nor seat.
model AuditRoom {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  auditorEmail  String
  expiresAt     DateTime
  allowDownload Boolean   @default(false)
  createdById   String
  revokedAt     DateTime?
  revokedById   String?
  /// When the auditor first came in (whoever created it is told once).
  firstAccessAt DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     AuditRoomItem[]
  codes     AuditRoomCode[]
  sessions  AuditRoomSession[]
  accesses  AuditRoomAccess[]

  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}

/// What a room shares: a node (document or folder), a space or a report with its parameters.
model AuditRoomItem {
  id          String   @id @default(cuid())
  workspaceId String
  roomId      String
  /// NODE, SPACE or REPORT.
  kind        String
  nodeId      String?
  spaceId     String?
  /// readings, approvals, form-records, training, ppe, audit-log.
  report      String?
  /// The report's parameters (node, form, course, dates, filters).
  params      Json?
  title       String
  addedById   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      AuditRoom @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, roomId])
}

/// A one-time code sent to the auditor's email (hash; 10 minutes; 5 tries).
model AuditRoomCode {
  id          String    @id @default(cuid())
  workspaceId String
  roomId      String
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      AuditRoom @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, roomId])
}

/// The auditor's session: its own cookie (hash of the token), never longer than the room.
model AuditRoomSession {
  id          String   @id @default(cuid())
  workspaceId String
  roomId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      AuditRoom @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, roomId])
}

/// Each time the auditor comes in, views or downloads something (for whoever created the room).
model AuditRoomAccess {
  id          String   @id @default(cuid())
  workspaceId String
  roomId      String
  /// enter, view, download.
  action      String
  itemId      String?
  /// What was opened, as shown (a document's name, a report's title).
  what        String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      AuditRoom @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, roomId, createdAt])
}

enum CaeAccessDirection {
  IN
  OUT
}

/// The gatehouse log (docs/spec/cae.md, «Modelo»), optional per company (settings.safety.cae.accessLog):
/// each entry or exit of a contractor's worker, with whether they were authorized and why not. Evidence:
/// added and read, never changed.
model CaeAccess {
  id          String             @id @default(cuid())
  workspaceId String
  workerId    String
  /// The worker's company at that moment (for the company's list).
  companyId   String
  at          DateTime           @default(now())
  direction   CaeAccessDirection
  authorized  Boolean
  reasons     String[]
  createdById String

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  worker    CaeWorker  @relation(fields: [workerId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  company   CaeCompany @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@index([workspaceId, at, id])
  @@index([workspaceId, companyId, at])
  @@index([workspaceId, workerId, at])
}

/// The site's information handed to a contractor (docs/spec/cae.md, «Información»; RD 171/2004, arts.
/// 7 to 9): which controlled documents, in which version, when and who received them. Evidence: added
/// and read, never changed.
model CaeInfoDelivery {
  id            String   @id @default(cuid())
  workspaceId   String
  companyId     String
  /// What was handed out, as it was then: [{ nodeId, version, code, title }].
  items         Json
  /// «nodeId@version» of each item, to know in the database what's been handed out.
  deliveredKeys String[]
  deliveredOn   DateTime @db.Date
  /// Who received it for the contractor.
  receivedBy    String
  /// Their signature, a PNG.
  signature     Bytes?
  createdById   String
  createdAt     DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CaeCompany @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@unique([id, workspaceId])
  @@index([workspaceId, companyId, deliveredOn])
}

enum CaePermitType {
  HOT_WORK
  HEIGHT
  CONFINED_SPACE
  ELECTRICAL
  OTHER
}

enum CaePermitStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

/// A work permit (docs/spec/cae.md, «Permisos de trabajo»): for contractors' workers and the company's
/// own staff. Issued as a draft, approved with a signature (then active within its dates), closed or
/// cancelled. Never deleted.
model CaeWorkPermit {
  id                String          @id @default(cuid())
  workspaceId       String
  type              CaePermitType
  /// The name of an OTHER permit.
  customName        String?
  /// The contractor doing the work, if any.
  companyId         String?
  location          String
  description       String
  validFrom         DateTime
  validTo           DateTime
  /// Contractors' workers (CaeWorker; no FK).
  workerIds         String[]
  /// The company's own people (memberships; no FK).
  membershipIds     String[]
  /// The precautions checklist: [{ label, done }].
  precautions       Json
  status            CaePermitStatus @default(DRAFT)
  issuedById        String
  approvedById      String?
  approvedAt        DateTime?
  /// Whoever approves it signs, a PNG.
  approvalSignature Bytes?
  closedAt          DateTime?
  closedById        String?
  /// How it was closed, or why it was cancelled.
  closeNote         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CaeCompany? @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, workspaceId])
  @@index([workspaceId, validFrom, id])
  @@index([workspaceId, status, validTo])
  @@index([workspaceId, companyId, validFrom])
}

/// A contractor's portal access (docs/spec/cae.md, «Portal de contratas»): a link with a code, for one
/// company. The code is only kept as a hash bound to the access. One active per company: a new one
/// revokes the previous. Never deleted.
model CaePortalAccess {
  id             String    @id @default(cuid())
  workspaceId    String
  companyId      String
  /// sha256(accessId:code), like the audit rooms' codes.
  codeHash       String
  /// Who issued it (membership; no FK): the portal reads and writes with their access.
  createdById    String
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedById    String?
  lastUsedAt     DateTime?
  /// Wrong codes in a row: past caeLimits.portalMaxFailedAttempts it stops working.
  failedAttempts Int       @default(0)
  /// Where the link was sent, if it was.
  email          String?
  createdAt      DateTime  @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   CaeCompany         @relation(fields: [companyId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  sessions  CaePortalSession[]
  uploads   CaePortalUpload[]
  documents CaeDocument[]

  @@unique([id, workspaceId])
  @@index([workspaceId, companyId, createdAt])
}

/// A portal session (its own httpOnly cookie, scoped to the access's path). Ended, never deleted.
model CaePortalSession {
  id          String    @id @default(cuid())
  workspaceId String
  accessId    String
  tokenHash   String    @unique
  expiresAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  access    CaePortalAccess @relation(fields: [accessId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@index([workspaceId, accessId])
}

/// A file the contractor is uploading through the portal: binds the upload (its id is the upload
/// reservation's) to the access and to the requirement it's for, so nothing else can be completed.
model CaePortalUpload {
  id            String    @id
  workspaceId   String
  accessId      String
  requirementId String
  workerId      String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  access    CaePortalAccess @relation(fields: [accessId, workspaceId], references: [id, workspaceId], onDelete: NoAction)

  @@index([workspaceId, accessId])
}

/// Hours worked and average headcount of one month (docs/spec/seguridad-salud.md, «Indicadores de
/// siniestralidad»), for the whole company (departmentId null) or one department: what the accident
/// rates are calculated with. Entered by safety.manage.
model SafetyMonthStat {
  id           String   @id @default(cuid())
  workspaceId  String
  /// The month's first day.
  month        DateTime @db.Date
  /// Null: the whole company (department; no FK).
  departmentId String?
  hoursWorked  Int
  avgHeadcount Float
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month, departmentId])
  @@index([workspaceId, departmentId, month])
}

/// An emergency team role (docs/spec/seguridad-salud.md, «Emergencias y simulacros»): emergency chief,
/// first aid, evacuation… with the training it requires, if any. Archived instead of deleted.
model SafetyEmergencyRole {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  nameKey     String
  /// The course its members need (SafetyCourse; no FK: a course can go with its document).
  courseId    String?
  position    Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   SafetyEmergencyMember[]

  @@unique([workspaceId, nameKey])
  @@unique([id, workspaceId])
  @@index([workspaceId, position])
}

/// Someone of the company in an emergency role, optionally for a work centre or shift (free text).
model SafetyEmergencyMember {
  id           String   @id @default(cuid())
  workspaceId  String
  roleId       String
  /// Membership; no FK.
  membershipId String
  /// Work centre or shift, free text.
  location     String?
  createdById  String
  createdAt    DateTime @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      SafetyEmergencyRole @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([roleId, membershipId])
  @@index([workspaceId, membershipId])
}

enum SafetyDrillScenario {
  FIRE
  EVACUATION
  SPILL
  AMMONIA
  OTHER
}

/// An emergency drill: when, what, where, how it went and what it shows has to change (its measures are
/// SafetyActions with origin DRILL). Never deleted.
model SafetyDrill {
  id                String              @id @default(cuid())
  workspaceId       String
  date              DateTime            @db.Date
  scenario          SafetyDrillScenario
  area              String?
  /// Announced beforehand to the staff.
  announced         Boolean             @default(false)
  participants      Int?
  /// From the alarm to the last person at the meeting point.
  evacuationSeconds Int?
  incidents         String?
  observers         String?
  /// A report or photos in the module's space (node; no FK).
  nodeId            String?
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions   SafetyAction[]

  @@unique([id, workspaceId])
  @@index([workspaceId, date, id])
}

/// A role in the health and safety committee (docs/spec/seguridad-salud.md, «Consulta y participación»).
enum SafetyCommitteeRole {
  /// Prevention delegate (es) / workers' representative (latam).
  DELEGATE
  COMPANY_REP
  /// The prevention technician, as an adviser (with a voice, without a vote).
  ADVISOR
  SECRETARY
}

/// Someone in the committee, with their term. Ending it keeps the row (it's the committee's history).
model SafetyCommitteeMember {
  id           String              @id @default(cuid())
  workspaceId  String
  membershipId String
  role         SafetyCommitteeRole
  termStart    DateTime?           @db.Date
  /// A delegate's term end: the `safety.mandate` expiry warns before it.
  termEnd      DateTime?           @db.Date
  endedAt      DateTime?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([id, workspaceId])
  @@index([workspaceId, membershipId])
  @@index([workspaceId, endedAt])
}

enum SafetyMeetingKind {
  ORDINARY
  EXTRAORDINARY
}

/// A committee meeting: its attendees, its agenda, its minutes and the agreements (planning actions).
model SafetyMeeting {
  id            String            @id @default(cuid())
  workspaceId   String
  date          DateTime          @db.Date
  kind          SafetyMeetingKind
  /// Committee member ids (SafetyCommitteeMember) who attended.
  attendeeIds   String[]
  agenda        String?
  /// The minutes: a page or file (node; no FK).
  minutesNodeId String?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions   SafetyAction[]

  @@unique([id, workspaceId])
  @@index([workspaceId, date, id])
  @@index([workspaceId, kind, date])
}

/// The app areas a space can belong to (docs/spec/diseno.md 10.4.1, navigation by areas).
enum SpaceArea {
  WIKI
  DOCUMENTS
  PREVENTION
  QUALITY
}

/// The area the app opens in (docs/spec/diseno.md 10.4.1).
enum HomeArea {
  HOME
  DOCUMENTS
  WIKI
  PREVENTION
  QUALITY
  ADMIN
}

// ─── Food quality (docs/spec/calidad.md) ─────────────────────────────────────────────────

enum QualityNcOrigin {
  INTERNAL
  CCP
  AUDIT_INTERNAL
  AUDIT_EXTERNAL
  COMPLAINT
  SUPPLIER
  LAB
  OTHER
}

enum QualitySeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum QualityNcStatus {
  OPEN
  ANALYSIS
  ACTIONS
  VERIFICATION
  CLOSED
  CANCELLED
}

enum QualityCauseMethod {
  FIVE_WHYS
  ISHIKAWA
  OTHER
}

enum QualityActionKind {
  CORRECTION
  CORRECTIVE
  PREVENTIVE
}

/// A nonconformity (NC): what went wrong, its root cause, its CAPA and the effectiveness check. Never
/// deleted: it's cancelled with a reason.
model QualityNc {
  id              String              @id @default(cuid())
  workspaceId     String
  /// NC-<year>-<number>, consecutive per company and year (QualityNcCounter).
  year            Int
  number          Int
  title           String
  description     String
  origin          QualityNcOrigin
  severity        QualitySeverity
  detectedOn      DateTime            @db.Date
  location        String?
  /// The department it's assigned to (no FK: departments can be deleted).
  departmentId    String?
  /// The form record it came from (no FK: records are never deleted) and its non-conforming fields.
  recordId        String?
  fieldIds        String[]
  productAffected Boolean             @default(false)
  productNote     String?
  /// The immediate correction, done at the moment.
  correction      String?
  causeMethod     QualityCauseMethod?
  /// The analysis, by method (validated by the service): { whys: string[] } or { branches: {…} }.
  causeAnalysis   Json?
  rootCause       String?
  status          QualityNcStatus     @default(OPEN)
  /// Membership in charge.
  ownerId         String
  verifyOn        DateTime?           @db.Date
  cancelReason    String?
  /// Its evidence folder in the module's space, once created.
  folderId        String?
  /// With origin SUPPLIER: the supplier it's about (phase 4).
  supplierId      String?
  reportedById    String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  closedAt        DateTime?
  closedById      String?

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions       QualityAction[]
  verifications QualityVerification[]
  events        QualityNcEvent[]
  holds         QualityHold[]
  findings      QualityFinding[]
  supplier      QualitySupplier?      @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, workspaceId])
  @@unique([workspaceId, year, number])
  @@index([workspaceId, status, detectedOn])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, recordId])
}

/// The last number given to a nonconformity of a company in a year.
model QualityNcCounter {
  workspaceId String
  year        Int
  last        Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, year])
}

/// A correction, corrective or preventive action of a nonconformity.
model QualityAction {
  id            String            @id @default(cuid())
  workspaceId   String
  ncId          String
  kind          QualityActionKind
  description   String
  /// Membership; no FK.
  responsibleId String
  dueOn         DateTime          @db.Date
  doneAt        DateTime?
  doneById      String?
  note          String?
  createdById   String
  createdAt     DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nc        QualityNc @relation(fields: [ncId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, ncId])
  @@index([workspaceId, responsibleId, doneAt])
  @@index([workspaceId, dueOn, id])
}

/// An effectiveness check: only added. The last effective one closes the nonconformity.
model QualityVerification {
  id           String   @id @default(cuid())
  workspaceId  String
  ncId         String
  effective    Boolean
  note         String
  verifiedById String
  verifiedAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nc        QualityNc @relation(fields: [ncId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, ncId, verifiedAt])
}

/// A nonconformity's history: only added, never changed.
model QualityNcEvent {
  id          String   @id @default(cuid())
  workspaceId String
  ncId        String
  /// created | updated | status | action_added | action_done | verified | cancelled | reopened
  kind        String
  actorId     String?
  data        Json
  at          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nc        QualityNc @relation(fields: [ncId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, ncId, at])
}

enum QualityHazardType {
  BIOLOGICAL
  CHEMICAL
  PHYSICAL
  ALLERGEN
}

enum QualityHoldStatus {
  HELD
  RELEASED
  REWORKED
  DIVERTED
  DESTROYED
}

/// A critical control point of the HACCP plan (docs/spec/calidad.md, «Fase 2»), linked to the form that
/// monitors it. Archived, never deleted.
model QualityCcp {
  id               String            @id @default(cuid())
  workspaceId      String
  code             String
  codeKey          String
  name             String
  step             String
  hazard           String
  hazardType       QualityHazardType
  criticalLimit    String
  /// The monitoring form (node; no FK: forms go to the trash).
  formId           String?
  frequency        String
  /// Membership; no FK.
  responsibleId    String?
  correctiveAction String
  verification     String
  position         Int
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, codeKey])
  @@index([workspaceId, position])
}

/// Product put on hold and the decision on it, signed (docs/spec/calidad.md, «Producto retenido»).
/// The decision is never changed nor deleted.
model QualityHold {
  id           String            @id @default(cuid())
  workspaceId  String
  ncId         String?
  product      String
  lot          String?
  /// The traced lot, if picked (no FK); `lot` keeps its code as text.
  lotId        String?
  quantity     String?
  location     String?
  reason       String
  status       QualityHoldStatus @default(HELD)
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  /// Whoever decides signs on screen: a PNG.
  signature    Bytes?
  createdById  String
  createdAt    DateTime          @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nc        QualityNc? @relation(fields: [ncId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, ncId])
}

enum QualityAuditScheme {
  INTERNAL
  IFS8
  BRCGS9
  CLIENT
  OFFICIAL
  OTHER
}

enum QualityAuditStatus {
  PLANNED
  DONE
  CANCELLED
}

/// An internal or external audit of the annual programme (docs/spec/calidad.md, «Fase 3»). Cancelled,
/// never deleted.
model QualityAudit {
  id           String             @id @default(cuid())
  workspaceId  String
  scheme       QualityAuditScheme
  title        String
  scope        String?
  plannedOn    DateTime           @db.Date
  doneOn       DateTime?          @db.Date
  auditor      String?
  /// Membership in charge of it in the company; no FK.
  leadId       String?
  /// The standard's chapters an internal audit covers («IFS8:4», «BRCGS9:2»).
  chapters     String[]
  status       QualityAuditStatus @default(PLANNED)
  result       String?
  /// An audit room for the external auditor (no FK: rooms are revoked, not deleted).
  auditRoomId  String?
  cancelReason String?
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  findings  QualityFinding[]

  @@unique([id, workspaceId])
  @@index([workspaceId, plannedOn, id])
}

/// A finding of an audit, by clause, with the nonconformity it opened. Only added.
model QualityFinding {
  id          String          @id @default(cuid())
  workspaceId String
  auditId     String
  clause      String
  description String
  severity    QualitySeverity
  ncId        String?
  createdById String
  createdAt   DateTime        @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  audit     QualityAudit @relation(fields: [auditId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  nc        QualityNc?   @relation(fields: [ncId, workspaceId], references: [id, workspaceId], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, auditId])
  @@index([workspaceId, ncId])
}

enum QualitySupplierCategory {
  RAW_MATERIAL
  INGREDIENT
  PACKAGING
  SERVICE
  OTHER
}

enum QualityRisk {
  LOW
  MEDIUM
  HIGH
}

enum QualitySupplierStatus {
  PENDING
  APPROVED
  CONDITIONAL
  BLOCKED
}

enum QualitySupplierDocKind {
  CERT_IFS
  CERT_BRCGS
  CERT_OTHER
  SPEC_SHEET
  QUESTIONNAIRE
  ANALYSIS
  OTHER
}

/// A supplier (docs/spec/calidad.md, «Fase 4»): what it supplies, its risk and fraud vulnerability, its
/// approval and next review. Archived, never deleted.
model QualitySupplier {
  id           String                  @id @default(cuid())
  workspaceId  String
  name         String
  nameKey      String
  taxId        String?
  category     QualitySupplierCategory
  supplies     String
  risk         QualityRisk
  fraudRisk    QualityRisk             @default(LOW)
  fraudNote    String?
  contact      String?
  /// Membership that follows it; no FK.
  ownerId      String?
  status       QualitySupplierStatus   @default(PENDING)
  nextReviewOn DateTime?               @db.Date
  folderId     String?
  archivedAt   DateTime?
  createdById  String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  docs      QualitySupplierDoc[]
  reviews   QualitySupplierReview[]
  ncs       QualityNc[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, nameKey])
  @@index([workspaceId, status])
}

/// A supplier's certificate, technical sheet or other document, with its expiry. Archived, never deleted.
model QualitySupplierDoc {
  id          String                 @id @default(cuid())
  workspaceId String
  supplierId  String
  kind        QualitySupplierDocKind
  name        String
  /// A file of the supplier's folder (node; no FK).
  nodeId      String?
  validUntil  DateTime?              @db.Date
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime               @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier  QualitySupplier @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, supplierId])
}

/// A supplier's yearly evaluation: only added.
model QualitySupplierReview {
  id           String                @id @default(cuid())
  workspaceId  String
  supplierId   String
  reviewedOn   DateTime              @db.Date
  scores       Json
  result       QualitySupplierStatus
  note         String
  reviewedById String
  createdAt    DateTime              @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplier  QualitySupplier @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, supplierId, reviewedOn])
}

enum QualityComplaintSource {
  CUSTOMER
  CONSUMER
  AUTHORITY
}

enum QualityComplaintCategory {
  FOREIGN_BODY
  ALLERGEN
  MICROBIOLOGICAL
  QUALITY
  LABELLING
  PACKAGING
  OTHER
}

enum QualityComplaintStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum QualityCrisisContactKind {
  AUTHORITY
  CUSTOMER
  INSURER
  LAB
  SUPPLIER
  OTHER
}

enum QualityRecallKind {
  DRILL
  REAL
}

enum QualityTraceDirection {
  BACKWARD
  FORWARD
  BOTH
}

/// A customer's, consumer's or authority's complaint (docs/spec/calidad.md, «Fase 5»). Closed, never
/// deleted.
model QualityComplaint {
  id          String                   @id @default(cuid())
  workspaceId String
  source      QualityComplaintSource
  from        String
  /// A consumer's phone or email: personal data (only quality.manage and the owner see it).
  contact     String?
  product     String
  lot         String?
  /// The traced lot, if picked (no FK); `lot` keeps its code as text.
  lotId       String?
  category    QualityComplaintCategory
  description String
  receivedOn  DateTime                 @db.Date
  respondBy   DateTime                 @db.Date
  respondedOn DateTime?                @db.Date
  response    String?
  justified   Boolean?
  status      QualityComplaintStatus   @default(OPEN)
  /// Membership in charge; no FK.
  ownerId     String
  /// The nonconformity it opened (no FK: NCs are never deleted).
  ncId        String?
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, receivedOn, id])
  @@index([workspaceId, status, respondBy])
}

/// The units sold in a month, for the complaints per million units.
model QualityMonthUnits {
  workspaceId String
  month       DateTime @db.Date
  units       Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, month])
}

/// A member of the crisis team (configuration: added and removed).
model QualityCrisisMember {
  id           String @id @default(cuid())
  workspaceId  String
  membershipId String
  role         String
  position     Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, membershipId])
}

/// An outside contact for a crisis or recall. Archived, never deleted.
model QualityCrisisContact {
  id           String                   @id @default(cuid())
  workspaceId  String
  kind         QualityCrisisContactKind
  name         String
  organization String?
  phone        String?
  email        String?
  notes        String?
  position     Int
  archivedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, position])
}

/// A recall drill (or a real recall): how long the traceability took and how much was recovered. Only
/// added.
model QualityRecallTest {
  id               String                @id @default(cuid())
  workspaceId      String
  kind             QualityRecallKind
  date             DateTime              @db.Date
  product          String
  lot              String
  /// The traced lot it was run on, if any (no FK).
  lotId            String?
  direction        QualityTraceDirection
  minutes          Int
  recoveredPercent Int?
  result           String
  ncId             String?
  createdById      String
  createdAt        DateTime              @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, date, id])
}

enum QualityPrpKind {
  CLEANING
  PEST
  WATER
  CALIBRATION
  GLASS
  WASTE
  OTHER
}

/// A prerequisite programme control (docs/spec/calidad.md, «Fase 6a»): done every N days by its
/// responsible person. Archived, never deleted.
model QualityPrp {
  id            String         @id @default(cuid())
  workspaceId   String
  kind          QualityPrpKind
  name          String
  location      String?
  everyDays     Int
  /// Membership; no FK.
  responsibleId String?
  /// A form where it's recorded (node; no FK).
  formId        String?
  lastDoneOn    DateTime?      @db.Date
  nextDueOn     DateTime       @db.Date
  notes         String?
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checks    QualityPrpCheck[]

  @@unique([id, workspaceId])
  @@index([workspaceId, kind, nextDueOn])
}

/// One time a prerequisite control was done: only added.
model QualityPrpCheck {
  id          String   @id @default(cuid())
  workspaceId String
  prpId       String
  doneOn      DateTime @db.Date
  conforming  Boolean
  note        String?
  ncId        String?
  doneById    String
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prp       QualityPrp @relation(fields: [prpId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, prpId, doneOn])
  @@index([workspaceId, doneOn])
}

enum QualityAllergen {
  GLUTEN
  CRUSTACEANS
  EGGS
  FISH
  PEANUTS
  SOY
  MILK
  NUTS
  CELERY
  MUSTARD
  SESAME
  SULPHITES
  LUPIN
  MOLLUSCS
}

/// A product the company makes, with its technical sheet data (docs/spec/calidad.md, «Fase 6b»).
/// specVersion goes up when what a label is checked against changes. Archived, never deleted.
model QualityProduct {
  id            String            @id @default(cuid())
  workspaceId   String
  code          String?
  name          String
  family        String?
  ingredients   String
  allergens     QualityAllergen[]
  mayContain    QualityAllergen[]
  /// Per 100 g: energyKj, energyKcal, fat, saturates, carbs, sugars, protein, salt.
  nutrition     Json?
  shelfLifeDays Int?
  storage       String?
  readyToEat    Boolean           @default(false)
  /// The sheet as a controlled document (node; no FK).
  specNodeId    String?
  /// Its folder «Productos/<name>» in the module's space (node; no FK).
  folderId      String?
  notes         String?
  specVersion   Int               @default(1)
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  studies   QualityShelfLifeStudy[]
  labels    QualityLabel[]

  @@unique([id, workspaceId])
  @@index([workspaceId, name])
}

enum QualityStudyResult {
  PENDING
  PASSED
  FAILED
}

/// A shelf life study of a product (with Listeria for ready-to-eat foods).
model QualityShelfLifeStudy {
  id           String             @id @default(cuid())
  workspaceId  String
  productId    String
  startedOn    DateTime           @db.Date
  targetDays   Int
  listeria     Boolean            @default(false)
  result       QualityStudyResult @default(PENDING)
  resultOn     DateTime?          @db.Date
  conclusion   String?
  /// A file of the product's folder (node; no FK).
  reportNodeId String?
  ncId         String?
  createdById  String
  createdAt    DateTime           @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   QualityProduct @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, productId, startedOn])
}

enum QualityLabelStatus {
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// A label version reviewed against Regulation 1169/2011 and the product's sheet version.
model QualityLabel {
  id            String             @id @default(cuid())
  workspaceId   String
  productId     String
  version       Int
  /// The artwork, a file of the product's folder (node; no FK).
  nodeId        String?
  status        QualityLabelStatus @default(IN_REVIEW)
  specVersion   Int
  checks        Json?
  note          String?
  submittedById String
  submittedAt   DateTime           @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   QualityProduct @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, productId, version])
  @@index([workspaceId, status])
}

enum QualitySamplingKind {
  PRODUCT
  SURFACE
  ENVIRONMENT
  WATER
}

/// A point of the sampling plan: what is analysed, against which criterion, every N days.
model QualitySamplingPoint {
  id            String              @id @default(cuid())
  workspaceId   String
  kind          QualitySamplingKind
  name          String
  /// A product (no FK).
  productId     String?
  zone          String?
  parameter     String
  criterion     String?
  maxValue      Float?
  unit          String?
  everyDays     Int
  laboratory    String?
  /// Membership; no FK.
  responsibleId String?
  lastSampledOn DateTime?           @db.Date
  nextDueOn     DateTime            @db.Date
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  results   QualityLabResult[]

  @@unique([id, workspaceId])
  @@index([workspaceId, kind, nextDueOn])
}

/// One laboratory result of a sampling point: only added.
model QualityLabResult {
  id           String   @id @default(cuid())
  workspaceId  String
  pointId      String
  sampledOn    DateTime @db.Date
  value        Float?
  detected     Boolean?
  conforming   Boolean
  /// The laboratory report, a file of the module's space (node; no FK).
  reportNodeId String?
  note         String?
  ncId         String?
  recordedById String
  createdAt    DateTime @default(now())

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  point     QualitySamplingPoint @relation(fields: [pointId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, pointId, sampledOn])
  @@index([workspaceId, sampledOn])
}

// ─── Food quality, phase 6c: food safety culture and change management (docs/spec/calidad.md) ──

enum QualityCultureKind {
  TRAINING
  COMMUNICATION
  SURVEY
  MEETING
  OTHER
}

/// The year's culture plan: its objectives (one per year).
model QualityCulturePlan {
  workspaceId String
  year        Int
  objectives  String
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, year])
}

model QualityCultureActivity {
  id            String             @id @default(cuid())
  workspaceId   String
  year          Int
  title         String
  kind          QualityCultureKind
  plannedOn     DateTime           @db.Date
  doneOn        DateTime?          @db.Date
  /// Membership; no FK.
  responsibleId String?
  note          String?
  archivedAt    DateTime?
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, year, plannedOn])
}

model QualityCultureSurvey {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  questions   String[]
  opensOn     DateTime  @db.Date
  closesOn    DateTime  @db.Date
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  answers   QualityCultureAnswer[]
  voters    QualityCultureVoter[]

  @@unique([id, workspaceId])
  @@index([workspaceId, opensOn])
}

/// An anonymous answer: no person and no time (a random id, not a time-ordered one). Who answered is
/// in QualityCultureVoter, with nothing linking the two.
model QualityCultureAnswer {
  id          String  @id @default(uuid())
  workspaceId String
  surveyId    String
  scores      Int[]
  comment     String?

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey    QualityCultureSurvey @relation(fields: [surveyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, surveyId])
}

/// Who already answered a survey (so nobody answers twice), without what or when.
model QualityCultureVoter {
  workspaceId  String
  surveyId     String
  /// Membership; no FK.
  membershipId String

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey    QualityCultureSurvey @relation(fields: [surveyId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@id([surveyId, membershipId])
  @@index([workspaceId, membershipId])
}

enum QualityChangeKind {
  RECIPE
  PRODUCT
  LINE
  EQUIPMENT
  SUPPLIER
  PROCESS
  OTHER
}

enum QualityChangeStatus {
  PROPOSED
  APPROVED
  REJECTED
  IMPLEMENTED
  CANCELLED
}

enum QualityChangeImpact {
  NONE
  LOW
  HIGH
}

model QualityChange {
  id            String               @id @default(cuid())
  workspaceId   String
  year          Int
  number        Int
  title         String
  kind          QualityChangeKind
  description   String
  /// A product (no FK).
  productId     String?
  plannedOn     DateTime?            @db.Date
  status        QualityChangeStatus  @default(PROPOSED)
  /// haccp, allergens, label, training, validation: { state: pending | not_applicable | done, note }.
  review        Json
  impact        QualityChangeImpact?
  /// Membership in charge of implementing it; no FK.
  ownerId       String?
  proposedById  String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  implementedOn DateTime?            @db.Date
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, year, number])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, status])
}

model QualityChangeCounter {
  workspaceId String
  year        Int
  last        Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, year])
}

// ─── Food quality, phase 7: traceability (docs/spec/calidad.md, «Fase 7») ──────────────────────

enum QualityLotKind {
  RAW
  INTERMEDIATE
  FINISHED
}

enum QualityTraceSource {
  MANUAL
  CSV
  PLUGIN
}

model QualityLot {
  id          String             @id @default(cuid())
  workspaceId String
  kind        QualityLotKind
  code        String
  /// A product (no FK).
  productId   String?
  material    String?
  /// A supplier (no FK); raw materials.
  supplierId  String?
  supplierLot String?
  origin      String?
  quantity    Decimal?           @db.Decimal(14, 3)
  unit        String?
  date        DateTime           @db.Date
  expiresOn   DateTime?          @db.Date
  source      QualityTraceSource @default(MANUAL)
  /// The plugin that loaded it.
  sourceId    String?
  externalId  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inputs    QualityLotLink[]  @relation("LotOutput")
  outputs   QualityLotLink[]  @relation("LotInput")
  shipments QualityShipment[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, kind, code])
  @@index([workspaceId, date, id])
  @@index([workspaceId, source, sourceId, externalId])
}

/// The input lot went into the output lot (a production order and its consumption are N links).
model QualityLotLink {
  id          String             @id @default(cuid())
  workspaceId String
  inputId     String
  outputId    String
  quantity    Decimal?           @db.Decimal(14, 3)
  unit        String?
  source      QualityTraceSource @default(MANUAL)
  sourceId    String?
  externalId  String?
  createdAt   DateTime           @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  input     QualityLot @relation("LotInput", fields: [inputId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  output    QualityLot @relation("LotOutput", fields: [outputId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([inputId, outputId])
  @@index([workspaceId, outputId])
  @@index([workspaceId, inputId])
}

/// A lot that went out to a customer.
model QualityShipment {
  id          String             @id @default(cuid())
  workspaceId String
  lotId       String
  customer    String
  document    String?
  shippedOn   DateTime           @db.Date
  quantity    Decimal?           @db.Decimal(14, 3)
  unit        String?
  source      QualityTraceSource @default(MANUAL)
  sourceId    String?
  externalId  String?
  createdAt   DateTime           @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lot       QualityLot @relation(fields: [lotId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([workspaceId, lotId])
  @@index([workspaceId, shippedOn, id])
}
