{
  "name": "@spiderfolio/backend",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "API de SpiderFolio (app.tudominio.com/api)",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:storage": "vitest run --config vitest.storage.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "node scripts/dev-watch.ts src/server.ts",
    "dev:worker": "node scripts/dev-watch.ts src/worker.ts",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "job:expiry-notices": "node --env-file-if-exists=../.env scripts/run-expiry-notices.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.4.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "diff": "9.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "1.13.0",
    "nodemailer": "10.0.14",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "jsqr": "1.4.0",
    "supertest": "7.3.1"
  }
}
