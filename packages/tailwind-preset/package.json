  },
  "peerDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/typography": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "tw-animate-css": {
      "optional": true
    }
  }
