  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Tokens y preset de Tailwind compartidos por app y web",
  "exports": {
    "./preset.css": "./preset.css",
    "./tokens.css": "./tokens.css",
    "./tokens": "./src/tokens.ts",
    "./accent": "./src/accent.ts"
